<section class="s-cta am-history-section" data-intersect>
  <div id="contact" class="s__inner js-container am-history-shell">
    <div class="am-history-panel js-history-panel">
      <header class="am-history-panel__header">
        <div>
          <p class="am-history-panel__eyebrow">AuraMirror</p>
          <h2 class="am-history-panel__title">History</h2>
        </div>

        <div class="am-history-header-actions">
          <div class="am-history-tabs" role="tablist" aria-label="History tabs">
            <button
              id="am-tab-tryon"
              class="am-history-tab is-active"
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="am-panel-tryon"
              data-history-tab="tryon"
            >Try-On History</button>
            <button
              id="am-tab-recommendation"
              class="am-history-tab"
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="am-panel-recommendation"
              data-history-tab="recommendation"
            >Recommendation History</button>
          </div>

          <button
            id="am-clear-history"
            class="am-button am-button--ghost"
            type="button"
            aria-label="Clear history"
            hidden
          >
            Clear
          </button>
        </div>
      </header>

      <div class="am-history-panel__body">
        <!-- Try-On History Panel -->
        <div
          id="am-panel-tryon"
          class="am-history-panel__tab-content"
          role="tabpanel"
          aria-labelledby="am-tab-tryon"
        >
          <div
            id="am-tryon-history-list"
            class="am-history-list am-tryon-list"
            aria-label="Try-on history list"
          >
            <div class="am-empty-state">Try-on history will appear here after your first virtual fitting.</div>
          </div>
        </div>

        <!-- Recommendation History Panel -->
        <div
          id="am-panel-recommendation"
          class="am-history-panel__tab-content"
          role="tabpanel"
          aria-labelledby="am-tab-recommendation"
          hidden
        >
          <div class="am-history-panel__body-inner">
            <div
              id="am-history-list"
              class="am-history-list"
              aria-label="Recommendation history list"
            >
              <div class="am-empty-state">Recommendation history will appear here.</div>
            </div>

            <aside
              id="am-history-focus"
              class="am-history-focus"
              aria-live="polite"
              aria-label="Focused recommendation details"
            >
              <p class="am-history-focus__eyebrow">Focus Detail</p>
              <div id="am-history-focus-content" class="am-history-focus__content">
                Hover or focus a history item to inspect its styling context.
              </div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="s__grid js-grid" aria-hidden="true">
    <svg class="s__grid__svg js-grid-svg" aria-hidden="true" focusable="false">
      <path class="s__grid__path js-grid-path" d=""></path>
    </svg>
  </div>
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'

  import { gsap } from 'gsap'

  class HistorySection {
    el: HTMLElement
    container: HTMLElement
    panel: HTMLElement

    bounding: DOMRect
    ctaMaxSize: number

    grid: {
      bounding: DOMRect
      width: number
      height: number
      vLines: number
      hLines: number
      gapX: number
      gapY: number
      lines: any[]
      points: any[][]
      rowOffsets: number[]
      el: HTMLElement
      svg: SVGElement
      path: SVGPathElement
    }

    wave: {
      progress: number
      op: number
      speed: number
      strength: number
      state: string
      timeout: number
    }

    isPaused: boolean
    tl: gsap.core.Timeline
    resizeObserver: ResizeObserver | null

    constructor() {
      const el = document.querySelector('.am-history-section') as HTMLElement

      if (!el) return

      const container = el.querySelector('.js-container') as HTMLElement
      const panel = el.querySelector('.js-history-panel') as HTMLElement
      const gridEl = el.querySelector('.js-grid') as HTMLElement
      const gridSvg = el.querySelector('.js-grid-svg') as SVGElement
      const gridPath = el.querySelector('.js-grid-path') as SVGPathElement

      if (!container || !panel || !gridEl || !gridSvg || !gridPath) return

      this.el = el
      this.container = container
      this.panel = panel

      this.grid = {
        bounding: new DOMRect(),
        width: 0,
        height: 0,
        vLines: 0,
        hLines: 0,
        gapX: 0,
        gapY: 0,
        lines: [],
        points: [],
        rowOffsets: [],
        el: gridEl,
        svg: gridSvg,
        path: gridPath,
      }

      this.wave = {
        progress: 0,
        op: 0,
        speed: window.safeWidth > 767 ? 15 : 10,
        strength: window.safeWidth > 767 ? 1 : 0.35,
        state: 'paused',
        timeout: 0,
      }

      this.isPaused = true
      this.tl = null
      this.resizeObserver = null

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      this.setSize()
      this.setGrid()
      this.createPulseTimeline()
      this.bindEvents()

      if (this.el.classList.contains('is-in-view') && this.isPaused) {
        this.isPaused = false
        Emitter.on('tick', this.tick, this)
      }
    }

    bindEvents() {
      Emitter.on('resize', this.onResize, this)

      if ('ResizeObserver' in window) {
        this.resizeObserver = new ResizeObserver(() => {
          this.setSize()
          this.setGrid()
        })

        this.resizeObserver.observe(this.el)
        this.resizeObserver.observe(this.container)
        this.resizeObserver.observe(this.panel)
      }

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })
    }

    onResize() {
      this.setSize()
      this.setGrid()
    }

    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }
    }

    createPulseTimeline() {
      const proxy = { scale: 0.85 }

      this.tl = gsap.timeline({
        repeat: -1,
        repeatDelay: 0.5,
      })

      this.tl.call(() => {
        this.wave.state = 'pulse'
      })

      this.tl.fromTo(
        proxy,
        {
          scale: 0.85,
        },
        {
          scale: 1.05,
          duration: 2.7,
          ease: 'power2.in',
        }
      )

      this.tl.call(this.wavePulse.bind(this), [])

      this.tl.to(proxy, {
        scale: 0.85,
        duration: 0.15,
        ease: 'power4.out',
      })
    }

    setSize() {
      this.grid.bounding = this.grid.el.getBoundingClientRect()
      this.bounding = this.container.getBoundingClientRect()
      this.ctaMaxSize = Math.max(
        Math.min(this.bounding.width, this.bounding.height) - 32,
        1
      )
    }

    setGrid() {
      const { grid } = this
      const width = this.grid.bounding.width
      const height = this.grid.bounding.height

      if (!width || !height) return

      grid.width = width
      grid.height = height

      grid.svg.style.width = `${width}px`
      grid.svg.style.height = `${height}px`

      grid.points = []
      grid.rowOffsets = []
      grid.vLines = window.safeWidth > 767 ? 12 : 8
      grid.gapX = width / grid.vLines

      grid.gapY = this.bounding.height / 8
      grid.hLines = Math.floor(height / grid.gapY)

      const offsetY = height - grid.gapY * grid.hLines
      const center = {
        x: width / 2,
        y: height - this.bounding.height / 2,
      }

      for (let i = 0; i <= grid.vLines; i++) {
        const row = []

        for (let j = 0; j <= grid.hLines; j++) {
          const point = {
            x: grid.gapX * i,
            y: grid.gapY * j + (j !== 0 ? offsetY : 0),
            row: j,
            ax: 0,
            ay: 0,
            vx: 0,
            vy: 0,
            wx: 0,
            wy: 0,
            mx: 0,
            my: 0,
            ox: 0,
            oy: 0,
            dx: 0,
            dy: 0,
            dist: 0,
          }

          const dx = point.x - center.x
          const dy = point.y - center.y
          const angle = Math.atan2(dy, dx)

          point.dist = Math.hypot(dx, dy)

          if (point.dist !== 0) {
            point.dx = Math.cos(angle) * (width / 2 / point.dist) * 5
            point.dy = Math.sin(angle) * (width / 2 / point.dist) * 5
          }

          row.push(point)
        }

        grid.points.push(row)
      }

      grid.rowOffsets = new Array(grid.hLines + 1).fill(0)

      this.drawLines()
    }

    movePoints() {
      const { grid, wave } = this
      const waveHypot = Math.hypot(window.safeHeight, window.safeWidth)
      const rowTotals = new Array(grid.hLines + 1).fill(0)
      const rowCounts = new Array(grid.hLines + 1).fill(0)

      grid.points.forEach((col) => {
        col.forEach((point, y) => {
          if (y === 0 || point.dist === 0) return

          const distance = Math.abs(point.dist - wave.progress)
          const length = 30

          if (distance < length) {
            const strength = 1 - distance / length
            const angle = Math.atan2(point.dy, point.dx)
            const force = Math.cos(distance * 0.01) * strength

            point.vx += Math.cos(angle) * force * length * 0.5 * wave.strength
            point.vy += Math.sin(angle) * force * length * 0.5 * wave.strength
          }

          point.vx += (0 - point.wx) * 0.001
          point.vy += (0 - point.wy) * 0.001

          point.vx *= 0.9
          point.vy *= 0.9

          point.wx += point.vx * 3
          point.wy += point.vy * 3

          point.wx *= 0.9
          point.wy *= 0.9

          point.mx = point.wx * 0.1
          point.my = point.wy * 0.1

          point.ox = point.dx / waveHypot
          point.oy = point.dy / waveHypot

          point.ox = this.easeOut(point.ox)
          point.oy = this.easeOut(point.oy)

          point.ox *= grid.gapX * 75 * (point.dist / this.ctaMaxSize)
          point.oy *= grid.gapY * 75 * (point.dist / this.ctaMaxSize)

          rowTotals[y] += point.my + point.oy * this.wave.op
          rowCounts[y] += 1
        })
      })

      grid.rowOffsets = rowTotals.map((total, index) => {
        if (!rowCounts[index]) return 0
        return total / rowCounts[index]
      })
    }

    easeOut(t) {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t)
    }

    movedPoint(point) {
      return {
        x: point.x + point.mx + point.ox * this.wave.op,
        y: point.y + (this.grid.rowOffsets[point.row] ?? 0),
      }
    }

    drawLines() {
      const { grid } = this

      let d = ''

      grid.points.forEach((col) => {
        col.forEach((point, index) => {
          const moved = this.movedPoint(point)

          if (index === 0) {
            d += `M ${moved.x} ${moved.y} `
          } else {
            d += `L ${moved.x} ${moved.y} `
          }
        })
      })

      for (let y = 0; y < grid.hLines; y++) {
        grid.points.forEach((col, x) => {
          const moved = this.movedPoint(col[y])

          if (x === 0) {
            d += `M ${moved.x} ${moved.y} `
          } else {
            d += `L ${moved.x} ${moved.y} `
          }
        })
      }

      grid.path.setAttribute('d', d)
    }

    wavePulse() {
      this.wave.progress = 0
      this.wave.state = 'pulse'
      this.wave.speed = window.safeWidth > 767 ? 15 : 10
      this.wave.strength = window.safeWidth > 767 ? 1 : 0.35
    }

    waveShock() {
      this.wave.progress = 0
      this.wave.state = 'shock'
      this.wave.speed = 30
      this.wave.strength = 5
    }

    tick(time) {
      if (this.wave.progress < this.grid.height) {
        if (this.wave.state !== 'paused') {
          this.wave.progress += this.wave.speed
        }
      }

      this.movePoints(time)
      this.drawLines()
    }
  }

  new HistorySection()
</script>

<style lang="scss">
  .s-cta.am-history-section {
    position: relative;
    z-index: 2;

    padding: clamp(8rem, 10vw, 10rem) 0 clamp(8rem, 12vw, 11rem);

    overflow: hidden;
    isolation: isolate;

    background:
      radial-gradient(circle at 50% 28%, rgba(244, 12, 63, 0.14), transparent 35%),
      linear-gradient(180deg, rgba(244, 12, 63, 0.08), transparent 28%);

    @include mq(tablet-sm) {
      padding-top: 7rem;
      padding-bottom: 8rem;
    }

    @include mq(phone) {
      padding-top: 5.5rem;
      padding-bottom: 6.5rem;
    }

    &:before {
      position: absolute;
      inset: 0;
      z-index: 0;

      background: radial-gradient(
        circle at 50% 44%,
        rgba(255, 255, 255, 0.24),
        transparent 54%
      );

      content: '';
      pointer-events: none;
    }

    .s__inner {
      position: relative;
      z-index: 3;
    }

    .am-history-panel {
      position: relative;
      z-index: 2;

      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08)),
        rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(10px);
      box-shadow: 0 1.5rem 3rem rgba(22, 0, 0, 0.08);

      &:before {
        position: absolute;
        inset: 0;
        z-index: 0;

        background:
          radial-gradient(circle at 50% 38%, rgba(244, 12, 63, 0.08), transparent 44%),
          linear-gradient(180deg, rgba(244, 12, 63, 0.08), transparent 32%);

        content: '';
        pointer-events: none;
      }
    }

    .am-history-panel__header,
    .am-history-panel__body {
      position: relative;
      z-index: 2;
    }

    .am-history-panel__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding: 1.25rem;
      border-bottom: 1px solid rgba(22, 0, 0, 0.12);
    }

    .am-history-header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .am-history-tabs {
      display: flex;
      gap: 0;
      border: 1px solid rgba(22, 0, 0, 0.18);
    }

    .am-history-tab {
      appearance: none;
      padding: 0.5rem 1rem;
      background: transparent;
      border: none;
      border-right: 1px solid rgba(22, 0, 0, 0.18);
      color: rgba(22, 0, 0, 0.5);
      font: 700 0.72rem / 1 var(--font-fraktion, monospace);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.18s ease, color 0.18s ease;

      &:last-child {
        border-right: none;
      }

      &.is-active {
        background: rgba(22, 0, 0, 0.06);
        color: rgba(22, 0, 0, 0.9);
      }

      &:hover:not(.is-active) {
        background: rgba(22, 0, 0, 0.03);
        color: rgba(22, 0, 0, 0.7);
      }
    }

    .am-history-panel__body {
      padding: 1.25rem;
    }

    .am-history-panel__body-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
      gap: 1rem;
      align-items: start;
    }

    .am-history-panel__tab-content[hidden] {
      display: none;
    }

    .am-tryon-list {
      grid-template-columns: unset;
    }

    .s__grid {
      position: absolute;
      top: -1px;
      left: -1px;
      z-index: 1;

      width: calc(100% + 2px);
      height: calc(100% + 2px);

      opacity: 1;
      pointer-events: none;

      &__svg {
        position: absolute;
        inset: 0;

        width: 100%;
        height: 100%;
      }

      &__path {
        fill: none;
        stroke: color(secondary);
        stroke-width: 1px;
        opacity: 1;
        stroke-linecap: round;
        stroke-linejoin: round;
        shape-rendering: geometricPrecision;
        vector-effect: non-scaling-stroke;
      }
    }

    &.is-out-of-view {
      .s__grid {
        display: none;
      }
    }
  }
</style>

<header class="site-head" data-intersect>
  <div class="site-head__container">
    <div class="sb-brand js-brand-target">
      <a href="/" aria-label="AuraMirror Home">
        <svg
          class="sb-brand__mark js-logo"
          width="280"
          height="280"
          viewBox="0 0 280 280"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M240.245 16.8V280h39.75V0h-160V280h39.755V16.8h19.8V280h39.755V16.8h19.8Z"
            fill="currentColor"
          >
          </path>
          <path d="M0 0v280h39.755V16.8H59.65V280h39.756V0H0Z" fill="currentColor">
          </path>
        </svg>

        <span class="sb-brand__name" aria-hidden="true">
          <span>Aura</span>
          <span>Mirror</span>
        </span>
      </a>
    </div>

    <button
      class="site-head__signout"
      type="button"
      hidden
      data-header-signout
      aria-label="Sign out"
    >
      Sign Out
    </button>
  </div>

</header>

<script>
  import { gsap } from 'gsap/dist/gsap'

  class Section {
    el: HTMLElement

    constructor() {
      this.el = document.querySelector('.site-head')

      if (!this.el) {
        return
      }

      this.bindEvents()
    }

    bindEvents() {
      document.addEventListener('intro', this.intro.bind(this), { once: true })
    }

    intro() {
      const tl = gsap.timeline()

      tl.to(
        this.el,
        {
          opacity: 1,
          duration: 0.45,
          ease: 'power2.out',
        },
        0
      )
    }
  }

  new Section()
</script>

<style lang="scss">
  .site-head {
    position: relative;
    z-index: 5;

    width: 100%;

    opacity: 0;

    &__container {
      @include flex(row, center, center);

      position: relative;
      width: 100%;
      height: 6rem;
      padding: 0 1.1rem;

      @include mq(phone) {
        height: 4rem;
        padding: 0 0.5rem;
      }
    }

    &__signout {
      appearance: none;
      position: absolute;
      top: 50%;
      right: 1.1rem;
      transform: translate3d(0, -50%, 0);
      border: 1px solid #000;
      background: #000;
      color: #fff;
      cursor: pointer;
      padding: 0.9rem 1.2rem;
      min-width: 8.5rem;
      border-radius: 0;
      font: 700 0.74rem / 1 font-family(fraktion);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;

      &:hover,
      &:focus-visible {
        background: #fff;
        color: #000;
        border-color: #000;
        outline: none;
        transform: translate3d(0, calc(-50% - 2px), 0);
      }

      &[hidden] {
        display: none;
      }

      @include mq(phone) {
        right: 0.5rem;
        padding: 0.65rem 0.75rem;
        font-size: 0.68rem;
      }
    }

    .sb-brand {
      a {
        @include flex(row, center, center);

        gap: 1rem;

        color: color(secondary);
        text-decoration: none;
      }

      .sb-brand__mark {
        width: 3rem;
        height: 3rem;
        color: color(secondary);
      }

      .sb-brand__name {
        @include flex(row, center, center);

        gap: 0.4rem;
        margin-top: 0.05em;

        font: 700 1.45rem / 0.86 font-family(bigger);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      @include mq(tablet) {
        a {
          gap: 0.7rem;
        }

        .sb-brand__name {
          font-size: 1.25rem;
        }
      }

      @include mq(phone) {
        a {
          gap: 0.6rem;
        }

        .sb-brand__mark {
          width: 1.875rem;
          height: 1.875rem;
        }

        .sb-brand__name {
          gap: 0.3rem;
          font-size: 0.95rem;
        }
      }
    }
  }
</style>

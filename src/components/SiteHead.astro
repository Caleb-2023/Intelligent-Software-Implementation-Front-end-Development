<header class="site-head" data-intersect>
  <div class="site-head__container">
    <div class="sb-logo">
      <a href="/" aria-label="AuraMirror Home">
        <svg
          class="js-logo"
          width="280"
          height="280"
          viewBox="0 0 280 280"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M240.245 16.8V280h39.75V0h-160V280h39.755V16.8h19.8V280h39.755V16.8h19.8Z"
            fill="currentColor"
          >
          </path>
          <path d="M0 0v280h39.755V16.8H59.65V280h39.756V0H0Z" fill="currentColor">
          </path>
        </svg>
      </a>
    </div>
  </div>

  <section id="am-auth-overlay" class="am-auth-overlay" hidden aria-hidden="true">
    <div class="am-auth-overlay__backdrop" data-am-close-auth></div>

    <div
      class="am-auth-overlay__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="am-auth-title"
    >
      <header class="am-auth-overlay__header">
        <div>
          <p class="am-auth-overlay__eyebrow">Module 00</p>
          <h2 id="am-auth-title" class="am-auth-overlay__title">Aura<br />Mirror</h2>
          <p class="am-auth-overlay__sub">AI Smart Wardrobe</p>
        </div>

        <button
          id="am-auth-close"
          class="am-styling-close"
          type="button"
          aria-label="Close authentication dialog"
        >
          Close
        </button>
      </header>

      <div class="am-auth-overlay__tabs" role="tablist" aria-label="Authentication tabs">
        <button
          id="am-auth-tab-login"
          class="am-auth-tab is-active"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="am-auth-panel-login"
          data-auth-tab="login"
        >
          Sign In
        </button>
        <button
          id="am-auth-tab-register"
          class="am-auth-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="am-auth-panel-register"
          data-auth-tab="register"
        >
          Register
        </button>
      </div>

      <div class="am-auth-overlay__body">
        <p id="am-auth-status" class="am-status am-auth-status">
          Sign in to connect the live wardrobe, remote try-on, and recommendation APIs.
        </p>

        <section
          id="am-auth-panel-login"
          class="am-auth-panel"
          role="tabpanel"
          aria-labelledby="am-auth-tab-login"
        >
          <form id="am-login-form" class="am-auth-form">
            <label class="am-label">
              Email
              <input
                id="am-login-email"
                class="am-input"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
              />
            </label>

            <label class="am-label">
              Password
              <input
                id="am-login-password"
                class="am-input"
                type="password"
                name="password"
                autocomplete="current-password"
                placeholder="Enter your password"
                required
              />
            </label>

            <button class="am-button am-auth-overlay__submit" type="submit">Sign In</button>
          </form>
        </section>

        <section
          id="am-auth-panel-register"
          class="am-auth-panel"
          role="tabpanel"
          aria-labelledby="am-auth-tab-register"
          hidden
        >
          <form id="am-register-form" class="am-auth-form">
            <label class="am-label">
              Name
              <input
                id="am-register-name"
                class="am-input"
                type="text"
                name="name"
                autocomplete="name"
                placeholder="Your name"
                required
              />
            </label>

            <label class="am-label">
              Email
              <input
                id="am-register-email"
                class="am-input"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
              />
            </label>

            <label class="am-label">
              Password
              <input
                id="am-register-password"
                class="am-input"
                type="password"
                name="password"
                autocomplete="new-password"
                placeholder="Minimum 6 characters"
                required
              />
            </label>

            <button class="am-button am-auth-overlay__submit" type="submit">Create Account</button>
          </form>
        </section>
      </div>

      <footer class="am-auth-overlay__footer">
        <span class="am-auth-overlay__footer-text">Your wardrobe / your data / your style.</span>
      </footer>
    </div>
  </section>
</header>

<script>
  import { gsap } from 'gsap'

  class Section {
    el: HTMLElement

    constructor() {
      this.el = document.querySelector('.site-head')

      if (!this.el) {
        return
      }

      this.bindEvents()
    }

    bindEvents() {
      document.addEventListener('intro', this.intro.bind(this), { once: true })
    }

    intro() {
      const logo = this.el.querySelector('.js-logo')
      if (!logo) return

      const tl = gsap.timeline()

      tl.set(this.el, {
        opacity: 1,
      })

      tl.from(
        this.el,
        {
          y: '-100%',
          duration: 1.5,
          ease: 'expo.inOut',
        },
        1
      )

      tl.from(
        logo,
        {
          y: '-100%',
          duration: 1.5,
          ease: 'expo.out',
        },
        1.5
      )

      tl.set(this.el, {
        clearProps: 'transform',
      })
    }
  }

  new Section()
</script>

<style lang="scss">
  .site-head {
    position: relative;
    z-index: 5;

    width: 100%;

    border-bottom: 1px solid color(secondary);
    opacity: 0;

    &__container {
      @include flex(row, center, center);

      width: 100%;
      height: 6rem;

      @include mq(phone) {
        height: 4rem;
      }
    }

    .sb-logo {
      @include flex(row, center, center);

      width: 6rem;
      height: 6rem;

      a {
        color: color(secondary);
        text-decoration: none;
      }

      @include mq(phone) {
        width: 4rem;
        height: 4rem;
      }

      svg {
        width: 3rem;
        height: 3rem;
        color: color(secondary);

        @include mq(phone) {
          width: 1.875rem;
          height: 1.875rem;
        }
      }
    }
  }
</style>

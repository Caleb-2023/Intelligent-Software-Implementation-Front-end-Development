<section id="am-figs-section" class="am-figs-section" data-intersect aria-label="Figure library">
  <div class="am-figs-grid" aria-hidden="true">
    <svg class="am-figs-grid__svg" aria-hidden="true" focusable="false">
      <path class="am-figs-grid__path" d=""></path>
    </svg>
  </div>

  <div class="am-figs-shell">
    <div class="am-figs-panel">
      <header class="am-figs-panel__header">
        <div>
          <p class="am-figs-eyebrow">Avatar Records</p>
          <h2 class="am-figs-title">Figure Library</h2>
        </div>

        <button
          id="am-figs-refresh"
          class="am-button am-button--ghost"
          type="button"
          aria-label="Refresh figure library"
        >
          Refresh
        </button>
      </header>

      <p id="am-figs-status" class="am-figs-status" role="status" aria-live="polite" hidden></p>

      <div class="am-figs-panel__body">
        <div id="am-figs-list" class="am-figs-list" aria-label="Saved figures">
          <div class="am-empty-state">Loading your figure library…</div>
        </div>

        <aside class="am-figs-focus" aria-live="polite" aria-label="Figure detail">
          <p class="am-figs-focus__eyebrow">Focus Detail</p>
          <div id="am-figs-focus-content" class="am-figs-focus__content">
            Select a figure’s “Details” to inspect its source photo and generated avatar.
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import { API_BASE_URL, STORAGE_KEYS } from '../auramirror/config.js'
  import { escapeHtml } from '../auramirror/dom'
  import { createRippleGrid } from '../auramirror/shared/grid.js'

  const FIGURE_HISTORY_URL = `${API_BASE_URL}/figures/history`
  const DEFAULT_PAGE = 1
  const DEFAULT_LIMIT = 20

  /** Read the stored JWT, tolerating disabled/locked localStorage. */
  function getToken() {
    try {
      return localStorage.getItem(STORAGE_KEYS.apiToken) || ''
    } catch {
      return ''
    }
  }

  /** Pull the figures array out of whatever envelope the backend returns. */
  function pickFigures(payload) {
    if (Array.isArray(payload)) return payload
    const data =
      payload && typeof payload === 'object' && payload.data != null
        ? payload.data
        : payload
    if (Array.isArray(data)) return data
    const bag = data && typeof data === 'object' ? data : {}
    return (
      (Array.isArray(bag.figures) && bag.figures) ||
      (Array.isArray(bag.history) && bag.history) ||
      (Array.isArray(bag.items) && bag.items) ||
      (Array.isArray(bag.records) && bag.records) ||
      (Array.isArray(payload?.figures) && payload.figures) ||
      []
    )
  }

  /** Map a raw record into a defensive, fully-defaulted shape. */
  function normalizeFigure(raw) {
    const r = raw && typeof raw === 'object' ? raw : {}
    const id = String(r.figure_id ?? r.id ?? r._id ?? '')
    const proxyUrl = id ? `${API_BASE_URL}/figures/${id}/image` : ''
    return {
      id,
      imageUrl: proxyUrl,
      avatarUrl: proxyUrl,
      status: String(r.status ?? 'completed'),
      createdAt: r.created_at ?? r.createdAt ?? null,
    }
  }

  /**
   * GET /api/figures/history?page&limit  (Authorization: Bearer <JWT>).
   * No body, no user_id. Returns a normalized figure array (tolerant of envelope).
   */
  async function fetchFigureHistory(page = DEFAULT_PAGE, limit = DEFAULT_LIMIT) {
    const token = getToken()
    const url = `${FIGURE_HISTORY_URL}?page=${encodeURIComponent(page)}&limit=${encodeURIComponent(limit)}`
    const response = await fetch(url, {
      method: 'GET',
      headers: token ? { Authorization: `Bearer ${token}` } : {},
    })
    const payload = await response.json().catch(() => null)
    if (!response.ok || payload?.success === false) {
      const err = new Error(
        payload?.message || payload?.error || `Request failed (${response.status})`
      )
      err.status = response.status
      throw err
    }
    return pickFigures(payload).map(normalizeFigure).filter((f) => f.id)
  }

  class FigureLibrary {
    constructor() {
      this.el = document.getElementById('am-figs-section')
      if (!this.el) return
      this.listEl = this.el.querySelector('#am-figs-list')
      this.focusEl = this.el.querySelector('#am-figs-focus-content')
      this.statusEl = this.el.querySelector('#am-figs-status')
      this.refreshBtn = this.el.querySelector('#am-figs-refresh')
      this.figures = []
      this.detailId = null
      this.page = DEFAULT_PAGE
      this.limit = DEFAULT_LIMIT
      if (document.readyState === 'complete') Ticker.nextTick(this.init, this)
      else Emitter.once('siteLoaded', this.init, this)
    }

    init() {
      this.initGrid()
      this.bindEvents()
      this.load()
    }

    initGrid() {
      const gridEl = this.el.querySelector('.am-figs-grid')
      const gridPath = this.el.querySelector('.am-figs-grid__path')
      if (gridEl && gridPath) this.grid = createRippleGrid(gridEl, gridPath)
    }

    bindEvents() {
      this.refreshBtn?.addEventListener('click', () => this.load())
      this.listEl?.addEventListener('click', this.onListClick.bind(this))
      document.addEventListener('am:auth-changed', () => this.load())
    }

    async load() {
      if (!this.listEl) return
      if (!getToken()) {
        this.listEl.innerHTML =
          '<div class="am-empty-state">Sign in to view and manage your saved figures.</div>'
        this.renderFocus(null)
        return
      }
      this.clearStatus()
      this.listEl.innerHTML =
        '<div class="am-empty-state">Loading your figure library…</div>'
      try {
        this.figures = await fetchFigureHistory(this.page, this.limit)
        this.renderFigures(this.figures)
      } catch (error) {
        this.renderError(error)
      }
    }

    formatStatus(status) {
      const map = { completed: 'Ready', ready: 'Ready', processing: 'Generating…', pending: 'Pending', failed: 'Failed' }
      const key = String(status || '').toLowerCase()
      if (map[key]) return map[key]
      return status ? status.charAt(0).toUpperCase() + status.slice(1) : 'Unknown'
    }

    isProcessing(status) {
      const key = String(status || '').toLowerCase()
      return key === 'processing' || key === 'pending'
    }

    shortenId(id) {
      return id.length > 16 ? `${id.slice(0, 6)}…${id.slice(-5)}` : id
    }

    /** Defensive renderer: tolerates empty list and missing image/status fields. */
    renderFigures(list) {
      if (!this.listEl) return
      const figures = Array.isArray(list) ? list : []
      if (!figures.length) {
        this.listEl.innerHTML =
          '<div class="am-empty-state">No figures yet. Open Avatar Studio to upload a portrait and generate your first avatar.</div>'
        this.renderFocus(null)
        return
      }
      this.listEl.innerHTML = figures.map((f) => this.cardHtml(f)).join('')
      this.attachImageFallbacks()
      if (!this.detailId || !figures.some((f) => f.id === this.detailId)) {
        this.detailId = null
        this.renderFocus(null)
      }
    }

    cardHtml(figure) {
      const safeId = escapeHtml(figure.id)
      const processing = this.isProcessing(figure.status)
      const thumbUrl = figure.avatarUrl || figure.imageUrl
      const media =
        thumbUrl && !processing
          ? `<span class="am-figs-card__thumb">
               <img class="am-figs-card__img"
                 data-auth-src="${escapeHtml(thumbUrl)}"
                 alt="Avatar ${safeId}" />
               <span class="am-figs-card__fallback" hidden>Preview unavailable</span>
             </span>`
          : `<span class="am-figs-card__thumb${processing ? ' is-processing' : ''}">
               <span class="am-figs-card__fallback">${processing ? 'Generating…' : 'No preview'}</span>
             </span>`
      const actions = `<button class="am-button am-button--ghost am-figs-card__action" type="button" data-action="detail">Details</button>`
      return `
        <article class="am-figs-card${processing ? ' is-processing' : ''}" data-figure-id="${safeId}">
          ${media}
          <span class="am-figs-card__eyebrow">Figure</span>
          <strong class="am-figs-card__title">${escapeHtml(this.shortenId(figure.id))}</strong>
          <span class="am-figs-card__meta am-figs-card__status" data-state="${escapeHtml(String(figure.status || 'unknown').toLowerCase())}">${escapeHtml(this.formatStatus(figure.status))}</span>
          <span class="am-figs-card__actions">${actions}</span>
        </article>`
    }

    attachImageFallbacks() {
      const token = getToken()
      this.listEl.querySelectorAll('img[data-auth-src]').forEach(async (img) => {
        const src = img.getAttribute('data-auth-src')
        const fallback = img.nextElementSibling
        if (!src) return
        try {
          const resp = await fetch(src, token ? { headers: { Authorization: `Bearer ${token}` } } : {})
          if (!resp.ok) throw new Error(`${resp.status}`)
          const blob = await resp.blob()
          const blobUrl = URL.createObjectURL(blob)
          img.src = blobUrl
          img.onload = () => URL.revokeObjectURL(blobUrl)
        } catch {
          img.style.display = 'none'
          if (fallback) fallback.hidden = false
        }
      })
    }

    onListClick(event) {
      const trigger = event.target.closest('[data-action]')
      if (!trigger) return
      const action = trigger.getAttribute('data-action')
      if (action === 'retry') { this.load(); return }
      const card = event.target.closest('[data-figure-id]')
      const id = card?.getAttribute('data-figure-id')
      if (!id) return
      if (action === 'detail') this.showDetail(id)
    }

    /** Self-contained: render focus-detail from already-loaded list data (no extra fetch). */
    showDetail(id) {
      this.detailId = id
      const figure = this.figures.find((f) => f.id === id)
      if (!figure) { this.renderFocus(null); return }
      this.renderFocusDetail(figure)
    }

    renderFocus(entry) {
      if (!this.focusEl || entry) return
      this.focusEl.innerHTML =
        'Select a figure’s “Details” to inspect its source photo and generated avatar.'
    }

    renderFocusDetail(figure) {
      if (!this.focusEl) return
      const block = (label, url) =>
        url
          ? `<figure class="am-figs-detail__media"><img src="${escapeHtml(url)}" alt="${escapeHtml(label)}" /><figcaption>${escapeHtml(label)}</figcaption></figure>`
          : `<figure class="am-figs-detail__media am-figs-detail__media--empty"><span>${escapeHtml(label)} unavailable</span></figure>`
      this.focusEl.innerHTML = `
        <div class="am-figs-detail">
          <div class="am-figs-detail__media-row">
            ${block('Source photo', figure.imageUrl)}
            ${block('Generated avatar', figure.avatarUrl)}
          </div>
          <p class="am-figs-detail__row"><strong>Status:</strong> ${escapeHtml(this.formatStatus(figure.status))}</p>
          <p class="am-figs-detail__row"><strong>Figure ID:</strong> ${escapeHtml(figure.id)}</p>
        </div>`
    }

    renderError(error) {
      if (!this.listEl) return
      const msg = error instanceof Error ? error.message : 'unknown error'
      this.listEl.innerHTML = `
        <div class="am-empty-state am-figs-error">
          <p>Couldn’t load your figures: ${escapeHtml(msg)}</p>
          <button class="am-button am-button--ghost" type="button" data-action="retry">Retry</button>
        </div>`
      this.renderFocus(null)
    }

    showStatus(message) {
      if (!this.statusEl) return
      this.statusEl.textContent = message
      this.statusEl.hidden = false
    }

    clearStatus() {
      if (!this.statusEl) return
      this.statusEl.textContent = ''
      this.statusEl.hidden = true
    }
  }

  new FigureLibrary()
</script>

<style is:global lang="scss">
  /* Namespaced `am-figs-*` rules. `is:global` is intentional: cards are rendered
     via innerHTML and would not match Astro-scoped selectors. */
  .am-figs-section {
    position: relative;
    z-index: 2;

    padding: 8rem 0 10rem;

    overflow: hidden;
    isolation: isolate;

    background:
      radial-gradient(circle at top left, rgba(244, 12, 63, 0.08), transparent 32%),
      linear-gradient(180deg, rgba(22, 0, 0, 0.04), transparent 22%);

    @include mq(tablet-sm) {
      padding: 6.5rem 0 8rem;
    }

    @include mq(phone) {
      padding: 5.5rem 0 6.5rem;
    }

    &:before {
      position: absolute;
      inset: 0;
      z-index: 0;

      background: radial-gradient(
        circle at 50% 44%,
        rgba(255, 255, 255, 0.24),
        transparent 54%
      );

      content: '';
      pointer-events: none;
    }
  }

  .am-figs-shell {
    position: relative;
    z-index: 1;

    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;

    @include mq(phone) {
      padding: 0 0.9rem;
    }
  }

  .am-figs-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .am-figs-grid__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .am-figs-grid__path {
    fill: none;
    stroke: color(secondary);
    stroke-width: 1px;
    opacity: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    shape-rendering: geometricPrecision;
    vector-effect: non-scaling-stroke;
  }

  .am-figs-panel {
    position: relative;
    z-index: 1;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(244, 12, 63, 0.06), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08)),
      rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
    box-shadow: 0 1.5rem 3rem rgba(22, 0, 0, 0.08);
  }

  .am-figs-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;

    padding: 1.25rem;
    border-bottom: 1px solid color(secondary);

    @include mq(phone) {
      flex-direction: column;
      align-items: stretch;
      padding: 0.9rem;
    }
  }

  .am-figs-eyebrow {
    margin: 0 0 0.5rem;
    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-title {
    margin: 0;
    font: 700 clamp(2rem, 4vw, 4.2rem) / 0.92 font-family(bigger);
    text-transform: uppercase;
  }

  .am-figs-status {
    margin: 0;
    padding: 1rem 1.25rem 0;

    color: var(--am-accent, #f40c3f);
    font: 400 0.95rem / 1.45 font-family(editorial);

    &[hidden] {
      display: none;
    }
  }

  .am-figs-panel__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 1rem;
    align-items: start;

    padding: 1.25rem;

    @include mq(tablet) {
      grid-template-columns: 1fr;
    }

    @include mq(phone) {
      padding: 0.9rem;
    }
  }

  .am-figs-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem;
    align-content: start;
  }

  .am-figs-focus {
    min-height: 20rem;
    padding: 1rem;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(244, 12, 63, 0.08), transparent 42%),
      rgba(255, 255, 255, 0.42);
  }

  .am-figs-focus__eyebrow {
    margin: 0 0 0.5rem;
    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-focus__content {
    font: 400 1rem / 1.5 font-family(editorial);
  }

  /* ---- card ---- */
  .am-figs-card {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;

    padding: 1rem;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.54)),
      rgba(244, 12, 63, 0.04);
    color: color(secondary);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      border-color: var(--am-accent, #f40c3f);
    }

    &.is-selected {
      border-color: var(--am-accent, #f40c3f);
      background:
        linear-gradient(180deg, rgba(244, 12, 63, 0.16), rgba(244, 12, 63, 0.06)),
        rgba(22, 0, 0, 0.03);
    }
  }

  .am-figs-card__badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;

    padding: 0.2rem 0.5rem;

    background: var(--am-accent, #f40c3f);
    color: #fff;
    font: 700 0.62rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-card__thumb {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.5rem;

    border: 1px solid rgba(22, 0, 0, 0.16);
    background:
      radial-gradient(circle at top, rgba(244, 12, 63, 0.12), transparent 55%),
      rgba(22, 0, 0, 0.08);
    overflow: hidden;

    &.is-processing {
      animation: am-figs-pulse 1.4s ease-in-out infinite;
    }
  }

  .am-figs-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .am-figs-card__fallback {
    padding: 1rem;
    text-align: center;
    font: 400 0.9rem / 1.35 font-family(editorial);
    color: color(secondary);
  }

  .am-figs-card__eyebrow {
    font: 700 0.72rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-card__title {
    margin: 0.1rem 0 0.15rem;
    font: 700 1.2rem / 0.95 font-family(bigger);
    text-transform: uppercase;
    word-break: break-all;
  }

  .am-figs-card__meta {
    font: 400 0.92rem / 1.3 font-family(editorial);
  }

  .am-figs-card__status[data-state='failed'] {
    color: var(--am-accent, #f40c3f);
  }

  .am-figs-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    width: 100%;
    margin-top: 0.6rem;
  }

  .am-figs-card__action {
    padding: 0.5rem 0.7rem;
    font-size: 0.66rem;
  }

  /* ---- detail ---- */
  .am-figs-detail__media-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;

    @include mq(phone) {
      grid-template-columns: 1fr;
    }
  }

  .am-figs-detail__media {
    margin: 0;
    border: 1px solid rgba(22, 0, 0, 0.16);
    overflow: hidden;

    img {
      display: block;
      width: 100%;
      height: auto;
    }

    figcaption {
      padding: 0.4rem 0.5rem;
      font: 700 0.66rem / 1 font-family(fraktion);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }

  .am-figs-detail__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    padding: 1rem;

    background: rgba(22, 0, 0, 0.06);
    text-align: center;
    font: 400 0.9rem / 1.3 font-family(editorial);
  }

  .am-figs-detail__row {
    margin: 0.35rem 0 0;
  }

  /* ---- error ---- */
  .am-figs-error {
    flex-direction: column;
    gap: 1rem;
  }

  @keyframes am-figs-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>

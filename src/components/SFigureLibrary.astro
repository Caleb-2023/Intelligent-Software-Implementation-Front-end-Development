<section id="am-figs-section" class="am-figs-section" data-intersect aria-label="Figure library">
  <div class="am-figs-grid" aria-hidden="true">
    <svg class="am-figs-grid__svg" aria-hidden="true" focusable="false">
      <path class="am-figs-grid__path" d=""></path>
    </svg>
  </div>

  <div class="am-figs-shell">
    <div class="am-figs-panel">
      <header class="am-figs-panel__header">
        <div>
          <p class="am-figs-eyebrow">Avatar Records</p>
          <h2 class="am-figs-title">Figure Library</h2>
        </div>

        <button
          id="am-figs-refresh"
          class="am-button am-button--ghost"
          type="button"
          aria-label="Refresh figure library"
        >
          Refresh
        </button>
      </header>

      <p id="am-figs-status" class="am-figs-status" role="status" aria-live="polite" hidden></p>

      <div class="am-figs-panel__body">
        <div id="am-figs-list" class="am-figs-list" aria-label="Saved figures">
          <div class="am-empty-state">Loading your figure library…</div>
        </div>

        <aside class="am-figs-focus" aria-live="polite" aria-label="Figure detail">
          <p class="am-figs-focus__eyebrow">Focus Detail</p>
          <div id="am-figs-focus-content" class="am-figs-focus__content">
            Select a figure’s “Details” to inspect its source photo and generated avatar.
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import { API_BASE_URL } from '../auramirror/config.js'
  import { escapeHtml } from '../auramirror/dom'
  import {
    getApiToken,
    authHeaders,
    apiFetch,
    resolveAssetUrl,
    pollTaskStatus,
  } from '../auramirror/shared/api.js'
  import { createRippleGrid } from '../auramirror/shared/grid.js'

  const FIGURES_URL = `${API_BASE_URL}/figures`
  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms))

  class FigureLibrary {
    constructor() {
      this.el = document.getElementById('am-figs-section')
      if (!this.el) return

      this.listEl = this.el.querySelector('#am-figs-list')
      this.focusEl = this.el.querySelector('#am-figs-focus-content')
      this.statusEl = this.el.querySelector('#am-figs-status')
      this.refreshBtn = this.el.querySelector('#am-figs-refresh')

      this.figures = []
      this.selectedId = null
      this.confirmingId = null
      this.detailId = null
      this.watching = new Set()

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      this.initGrid()
      this.bindEvents()
      this.load()
    }

    initGrid() {
      const gridEl = this.el.querySelector('.am-figs-grid')
      const gridPath = this.el.querySelector('.am-figs-grid__path')
      if (gridEl && gridPath) this.grid = createRippleGrid(gridEl, gridPath)
    }

    bindEvents() {
      this.refreshBtn?.addEventListener('click', () => this.load())
      this.listEl?.addEventListener('click', this.onListClick.bind(this))
    }

    /* ---------- data ---------- */

    async load() {
      if (!this.listEl) return

      if (!getApiToken()) {
        this.renderAuthGate()
        return
      }

      this.clearStatus()
      this.listEl.innerHTML =
        '<div class="am-empty-state">Loading your figure library…</div>'

      try {
        const data = await apiFetch(FIGURES_URL, { headers: authHeaders() })
        const items = Array.isArray(data)
          ? data
          : data?.figures || data?.data?.figures || []
        this.figures = items
          .map((item) => this.normalizeFigure(item))
          .filter((item) => item.id)
        this.renderList()
      } catch (error) {
        this.renderError(error)
      }
    }

    normalizeFigure(raw) {
      return {
        id: String(raw?.figure_id || raw?._id || raw?.id || ''),
        imageUrl: String(raw?.image_url || raw?.imageUrl || raw?.source_image_uri || ''),
        avatarUrl: String(raw?.avatar_url || raw?.avatarUrl || raw?.avatar_image_uri || ''),
        status: String(raw?.status || 'completed'),
        taskId: String(raw?.task_id || raw?.taskId || ''),
      }
    }

    formatStatus(status) {
      const map = {
        completed: 'Ready',
        ready: 'Ready',
        processing: 'Generating…',
        pending: 'Pending',
        failed: 'Failed',
      }
      const key = String(status || '').toLowerCase()
      if (map[key]) return map[key]
      return status ? status.charAt(0).toUpperCase() + status.slice(1) : 'Unknown'
    }

    isProcessing(status) {
      const key = String(status || '').toLowerCase()
      return key === 'processing' || key === 'pending'
    }

    shortenId(id) {
      return id.length > 16 ? `${id.slice(0, 6)}…${id.slice(-5)}` : id
    }

    /* ---------- rendering ---------- */

    renderList() {
      if (!this.listEl) return

      if (!this.figures.length) {
        this.listEl.innerHTML =
          '<div class="am-empty-state">No figures yet. Open Avatar Studio to upload a portrait and generate your first avatar.</div>'
        this.renderFocus(null)
        return
      }

      this.listEl.innerHTML = this.figures
        .map((figure) => this.cardHtml(figure))
        .join('')
      this.attachImageFallbacks()
      this.watchProcessing()

      if (!this.detailId || !this.figures.some((figure) => figure.id === this.detailId)) {
        this.detailId = null
        this.renderFocus(null)
      }
    }

    cardHtml(figure) {
      const safeId = escapeHtml(figure.id)
      const selected = figure.id === this.selectedId
      const confirming = figure.id === this.confirmingId
      const processing = this.isProcessing(figure.status)
      const thumbUrl = resolveAssetUrl(figure.avatarUrl || figure.imageUrl)

      const media =
        thumbUrl && !processing
          ? `<span class="am-figs-card__thumb">
               <img class="am-figs-card__img" src="${escapeHtml(thumbUrl)}" alt="Avatar ${safeId}" loading="lazy" />
               <span class="am-figs-card__fallback" hidden>Preview unavailable</span>
             </span>`
          : `<span class="am-figs-card__thumb${processing ? ' is-processing' : ''}">
               <span class="am-figs-card__fallback">${processing ? 'Generating…' : 'No preview'}</span>
             </span>`

      const actions = confirming
        ? `<button class="am-button am-figs-card__action" type="button" data-action="confirm-delete">Confirm</button>
           <button class="am-button am-button--ghost am-figs-card__action" type="button" data-action="cancel-delete">Cancel</button>`
        : `<button class="am-button am-figs-card__action" type="button" data-action="use"${selected ? ' disabled' : ''}>${selected ? 'In Use' : 'Use'}</button>
           <button class="am-button am-button--ghost am-figs-card__action" type="button" data-action="detail">Details</button>
           <button class="am-button am-button--ghost am-figs-card__action" type="button" data-action="delete"${processing ? ' disabled' : ''}>Delete</button>`

      return `
        <article class="am-figs-card${selected ? ' is-selected' : ''}${processing ? ' is-processing' : ''}" data-figure-id="${safeId}">
          ${selected ? '<span class="am-figs-card__badge">Active</span>' : ''}
          ${media}
          <span class="am-figs-card__eyebrow">Figure</span>
          <strong class="am-figs-card__title">${escapeHtml(this.shortenId(figure.id))}</strong>
          <span class="am-figs-card__meta am-figs-card__status" data-state="${escapeHtml(String(figure.status || 'unknown').toLowerCase())}">${escapeHtml(this.formatStatus(figure.status))}</span>
          <span class="am-figs-card__actions">${actions}</span>
        </article>`
    }

    attachImageFallbacks() {
      this.listEl.querySelectorAll('.am-figs-card__img').forEach((img) => {
        img.addEventListener(
          'error',
          () => {
            img.style.display = 'none'
            const fallback = img.parentElement?.querySelector('.am-figs-card__fallback')
            if (fallback) fallback.hidden = false
          },
          { once: true }
        )
      })
    }

    renderFocus(entry) {
      if (!this.focusEl) return
      if (!entry) {
        this.focusEl.innerHTML =
          'Select a figure’s “Details” to inspect its source photo and generated avatar.'
      }
    }

    renderFocusLoading() {
      if (this.focusEl) this.focusEl.innerHTML = 'Loading figure details…'
    }

    renderFocusDetail(id, detail) {
      if (!this.focusEl) return

      const sourceUrl = resolveAssetUrl(detail.source_image_uri || detail.image_url || '')
      const avatarUrl = resolveAssetUrl(detail.avatar_image_uri || detail.avatar_url || '')
      const status = this.formatStatus(detail.status)

      const mediaBlock = (label, url) =>
        url
          ? `<figure class="am-figs-detail__media">
               <img src="${escapeHtml(url)}" alt="${escapeHtml(label)}" />
               <figcaption>${escapeHtml(label)}</figcaption>
             </figure>`
          : `<figure class="am-figs-detail__media am-figs-detail__media--empty">
               <span>${escapeHtml(label)} unavailable</span>
             </figure>`

      this.focusEl.innerHTML = `
        <div class="am-figs-detail">
          <div class="am-figs-detail__media-row">
            ${mediaBlock('Source photo', sourceUrl)}
            ${mediaBlock('Generated avatar', avatarUrl)}
          </div>
          <p class="am-figs-detail__row"><strong>Status:</strong> ${escapeHtml(status)}</p>
          <p class="am-figs-detail__row"><strong>Figure ID:</strong> ${escapeHtml(id)}</p>
        </div>`
    }

    renderFocusError(error) {
      if (this.focusEl) {
        this.focusEl.innerHTML = `Couldn’t load detail: ${escapeHtml(this.errorMessage(error))}`
      }
    }

    renderAuthGate() {
      if (this.listEl) {
        this.listEl.innerHTML =
          '<div class="am-empty-state">Sign in to view and manage your saved figures.</div>'
      }
      this.renderFocus(null)
    }

    renderError(error) {
      if (!this.listEl) return
      this.listEl.innerHTML = `
        <div class="am-empty-state am-figs-error">
          <p>Couldn’t load your figures: ${escapeHtml(this.errorMessage(error))}</p>
          <button class="am-button am-button--ghost" type="button" data-action="retry">Retry</button>
        </div>`
      this.renderFocus(null)
    }

    /* ---------- interaction ---------- */

    onListClick(event) {
      const trigger = event.target.closest('[data-action]')
      if (!trigger) return

      const action = trigger.getAttribute('data-action')
      if (action === 'retry') {
        this.load()
        return
      }

      const card = event.target.closest('[data-figure-id]')
      const id = card?.getAttribute('data-figure-id')
      if (!id) return

      if (action === 'use') this.selectFigure(id)
      else if (action === 'detail') this.showDetail(id)
      else if (action === 'delete') this.setConfirming(id)
      else if (action === 'confirm-delete') this.deleteFigure(id)
      else if (action === 'cancel-delete') this.setConfirming(null)
    }

    setConfirming(id) {
      this.confirmingId = id
      this.renderList()
    }

    selectFigure(id) {
      this.selectedId = id
      this.renderList()
      document.dispatchEvent(
        new CustomEvent('am:figure-selected', { detail: { figureId: id } })
      )
    }

    async showDetail(id) {
      this.detailId = id
      this.renderFocusLoading()
      try {
        const data = await apiFetch(`${FIGURES_URL}/${encodeURIComponent(id)}`, {
          headers: authHeaders(),
        })
        this.renderFocusDetail(id, data?.figure || data || {})
      } catch (error) {
        this.renderFocusError(error)
      }
    }

    async deleteFigure(id) {
      try {
        await apiFetch(`${FIGURES_URL}/${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: authHeaders(),
        })
        this.figures = this.figures.filter((figure) => figure.id !== id)
        this.confirmingId = null
        if (this.selectedId === id) {
          this.selectedId = null
          document.dispatchEvent(
            new CustomEvent('am:figure-selected', { detail: { figureId: null } })
          )
        }
        if (this.detailId === id) this.detailId = null
        this.clearStatus()
        this.renderList()
      } catch (error) {
        this.confirmingId = null
        this.showStatus(`Delete failed: ${this.errorMessage(error)}`)
        this.renderList()
      }
    }

    /* ---------- processing watcher ---------- */

    watchProcessing() {
      this.figures.forEach((figure) => {
        if (this.isProcessing(figure.status) && !this.watching.has(figure.id)) {
          this.watching.add(figure.id)
          this.pollFigure(figure)
        }
      })
    }

    async pollFigure(figure) {
      try {
        if (figure.taskId) {
          await pollTaskStatus(figure.taskId)
          await this.refreshFigure(figure.id)
          return
        }

        for (let attempt = 0; attempt < 40; attempt += 1) {
          await sleep(3000)
          if (!document.getElementById('am-figs-section')) return
          const settled = await this.refreshFigure(figure.id)
          if (settled) return
        }
      } catch {
        // Leave the card as-is; the user can refresh manually.
      } finally {
        this.watching.delete(figure.id)
      }
    }

    /** Refetch one figure; returns true once its status is no longer processing. */
    async refreshFigure(id) {
      let detail
      try {
        detail = await apiFetch(`${FIGURES_URL}/${encodeURIComponent(id)}`, {
          headers: authHeaders(),
        })
      } catch {
        return false
      }

      const next = this.normalizeFigure({
        ...(detail?.figure || detail || {}),
        figure_id: id,
      })
      const index = this.figures.findIndex((figure) => figure.id === id)
      if (index < 0) return true

      this.figures[index] = next
      this.renderList()
      return !this.isProcessing(next.status)
    }

    /* ---------- status helpers ---------- */

    showStatus(message) {
      if (!this.statusEl) return
      this.statusEl.textContent = message
      this.statusEl.hidden = false
    }

    clearStatus() {
      if (!this.statusEl) return
      this.statusEl.textContent = ''
      this.statusEl.hidden = true
    }

    errorMessage(error) {
      return error instanceof Error ? error.message : 'unknown error'
    }
  }

  new FigureLibrary()
</script>

<style is:global lang="scss">
  /* Namespaced `am-figs-*` rules. `is:global` is intentional: cards are rendered
     via innerHTML and would not match Astro-scoped selectors. */
  .am-figs-section {
    position: relative;
    z-index: 2;

    padding: 8rem 0 10rem;

    overflow: hidden;
    isolation: isolate;

    background:
      radial-gradient(circle at top left, rgba(244, 12, 63, 0.08), transparent 32%),
      linear-gradient(180deg, rgba(22, 0, 0, 0.04), transparent 22%);

    @include mq(tablet-sm) {
      padding: 6.5rem 0 8rem;
    }

    @include mq(phone) {
      padding: 5.5rem 0 6.5rem;
    }

    &:before {
      position: absolute;
      inset: 0;
      z-index: 0;

      background: radial-gradient(
        circle at 50% 44%,
        rgba(255, 255, 255, 0.24),
        transparent 54%
      );

      content: '';
      pointer-events: none;
    }
  }

  .am-figs-shell {
    position: relative;
    z-index: 1;

    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;

    @include mq(phone) {
      padding: 0 0.9rem;
    }
  }

  .am-figs-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .am-figs-grid__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .am-figs-grid__path {
    fill: none;
    stroke: color(secondary);
    stroke-width: 1px;
    opacity: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    shape-rendering: geometricPrecision;
    vector-effect: non-scaling-stroke;
  }

  .am-figs-panel {
    position: relative;
    z-index: 1;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(244, 12, 63, 0.06), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08)),
      rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
    box-shadow: 0 1.5rem 3rem rgba(22, 0, 0, 0.08);
  }

  .am-figs-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;

    padding: 1.25rem;
    border-bottom: 1px solid color(secondary);

    @include mq(phone) {
      flex-direction: column;
      align-items: stretch;
      padding: 0.9rem;
    }
  }

  .am-figs-eyebrow {
    margin: 0 0 0.5rem;
    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-title {
    margin: 0;
    font: 700 clamp(2rem, 4vw, 4.2rem) / 0.92 font-family(bigger);
    text-transform: uppercase;
  }

  .am-figs-status {
    margin: 0;
    padding: 1rem 1.25rem 0;

    color: var(--am-accent, #f40c3f);
    font: 400 0.95rem / 1.45 font-family(editorial);

    &[hidden] {
      display: none;
    }
  }

  .am-figs-panel__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 1rem;
    align-items: start;

    padding: 1.25rem;

    @include mq(tablet) {
      grid-template-columns: 1fr;
    }

    @include mq(phone) {
      padding: 0.9rem;
    }
  }

  .am-figs-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem;
    align-content: start;
  }

  .am-figs-focus {
    min-height: 20rem;
    padding: 1rem;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(244, 12, 63, 0.08), transparent 42%),
      rgba(255, 255, 255, 0.42);
  }

  .am-figs-focus__eyebrow {
    margin: 0 0 0.5rem;
    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-focus__content {
    font: 400 1rem / 1.5 font-family(editorial);
  }

  /* ---- card ---- */
  .am-figs-card {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;

    padding: 1rem;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.54)),
      rgba(244, 12, 63, 0.04);
    color: color(secondary);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      border-color: var(--am-accent, #f40c3f);
    }

    &.is-selected {
      border-color: var(--am-accent, #f40c3f);
      background:
        linear-gradient(180deg, rgba(244, 12, 63, 0.16), rgba(244, 12, 63, 0.06)),
        rgba(22, 0, 0, 0.03);
    }
  }

  .am-figs-card__badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;

    padding: 0.2rem 0.5rem;

    background: var(--am-accent, #f40c3f);
    color: #fff;
    font: 700 0.62rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-card__thumb {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.5rem;

    border: 1px solid rgba(22, 0, 0, 0.16);
    background:
      radial-gradient(circle at top, rgba(244, 12, 63, 0.12), transparent 55%),
      rgba(22, 0, 0, 0.08);
    overflow: hidden;

    &.is-processing {
      animation: am-figs-pulse 1.4s ease-in-out infinite;
    }
  }

  .am-figs-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .am-figs-card__fallback {
    padding: 1rem;
    text-align: center;
    font: 400 0.9rem / 1.35 font-family(editorial);
    color: color(secondary);
  }

  .am-figs-card__eyebrow {
    font: 700 0.72rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-figs-card__title {
    margin: 0.1rem 0 0.15rem;
    font: 700 1.2rem / 0.95 font-family(bigger);
    text-transform: uppercase;
    word-break: break-all;
  }

  .am-figs-card__meta {
    font: 400 0.92rem / 1.3 font-family(editorial);
  }

  .am-figs-card__status[data-state='failed'] {
    color: var(--am-accent, #f40c3f);
  }

  .am-figs-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    width: 100%;
    margin-top: 0.6rem;
  }

  .am-figs-card__action {
    padding: 0.5rem 0.7rem;
    font-size: 0.66rem;
  }

  /* ---- detail ---- */
  .am-figs-detail__media-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;

    @include mq(phone) {
      grid-template-columns: 1fr;
    }
  }

  .am-figs-detail__media {
    margin: 0;
    border: 1px solid rgba(22, 0, 0, 0.16);
    overflow: hidden;

    img {
      display: block;
      width: 100%;
      height: auto;
    }

    figcaption {
      padding: 0.4rem 0.5rem;
      font: 700 0.66rem / 1 font-family(fraktion);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }

  .am-figs-detail__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    padding: 1rem;

    background: rgba(22, 0, 0, 0.06);
    text-align: center;
    font: 400 0.9rem / 1.3 font-family(editorial);
  }

  .am-figs-detail__row {
    margin: 0.35rem 0 0;
  }

  /* ---- error ---- */
  .am-figs-error {
    flex-direction: column;
    gap: 1rem;
  }

  @keyframes am-figs-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>

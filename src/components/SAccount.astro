<section id="account" class="s-account" hidden aria-hidden="true">
  <div class="s-account__shell">
    <div class="s-account__frame">
      <div class="s-account__toolbar">
        <button
          id="am-account-close"
          class="s-account__close"
          type="button"
          data-dashboard-close
        >
          Close
        </button>
      </div>

      <div class="s-account__hero">
        <div class="s-account__copy">
          <p class="s-account__eyebrow">Signed-In Interface</p>
          <h2 class="s-account__title">
            Control
            <br />
            Deck
          </h2>
          <p id="am-account-greeting" class="s-account__lede">
            Your private styling workspace appears here after login.
          </p>
        </div>

        <div class="s-account__identity">
          <span class="s-account__identity-label">Profile</span>
          <strong id="am-account-name" class="s-account__identity-name">
            Aura Member
          </strong>
          <span id="am-account-email" class="s-account__identity-email">
            you@example.com
          </span>

          <div class="s-account__identity-meta">
            <div class="s-account__identity-row">
              <span>Member Since</span>
              <strong id="am-account-member-since">Today</strong>
            </div>

            <div class="s-account__identity-row">
              <span>Session Mode</span>
              <strong id="am-account-mode">Local Demo</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="s-account__grid">
        <article class="s-account__card s-account__card--status">
          <p class="s-account__card-eyebrow">System Pulse</p>

          <div class="s-account__status-list">
            <div class="s-account__status-row">
              <span>Avatar</span>
              <strong id="am-account-avatar-status">Waiting for portrait</strong>
            </div>

            <div class="s-account__status-row">
              <span>Wardrobe</span>
              <strong id="am-account-wardrobe-status">Demo wardrobe standby</strong>
            </div>

            <div class="s-account__status-row">
              <span>Preview</span>
              <strong id="am-account-preview-status">No try-on preview yet</strong>
            </div>

            <div class="s-account__status-row">
              <span>Saved Looks</span>
              <strong id="am-account-history-count">0 saved runs</strong>
            </div>
          </div>
        </article>

        <article class="s-account__card s-account__card--actions">
          <p class="s-account__card-eyebrow">Quick Launch</p>

          <div class="s-account__actions">
            <button id="am-account-open-avatar" class="s-account__button" type="button">
              Avatar Studio
            </button>

            <button id="am-account-open-wardrobe" class="s-account__button" type="button">
              Open Wardrobe
            </button>

            <button id="am-account-open-ai" class="s-account__button" type="button">
              AI Stylist
            </button>

            <button
              id="am-account-open-history"
              class="s-account__button s-account__button--ghost"
              type="button"
            >
              View History
            </button>

            <button
              id="am-account-signout"
              class="s-account__button s-account__button--ghost"
              type="button"
              data-signout-trigger
            >
              Sign Out
            </button>
          </div>
        </article>

        <article class="s-account__card s-account__card--snapshot">
          <p class="s-account__card-eyebrow">Session Snapshot</p>

          <div class="s-account__snapshot-grid">
            <div class="s-account__snapshot-box">
              <span class="s-account__snapshot-label">Weather</span>
              <strong id="am-account-weather" class="s-account__snapshot-value">
                Fallback Studio / controlled / 22 C
              </strong>
            </div>

            <div class="s-account__snapshot-box">
              <span class="s-account__snapshot-label">Selection</span>
              <strong id="am-account-selection-count" class="s-account__snapshot-value">
                0 garments selected
              </strong>
            </div>
          </div>
        </article>

        <article class="s-account__card s-account__card--focus">
          <p class="s-account__card-eyebrow">Next Move</p>
          <p id="am-account-next-step" class="s-account__focus">
            Upload a portrait photo first so the dashboard can unlock avatar and
            preview actions.
          </p>
        </article>

        <article class="s-account__card s-account__card--recommendation">
          <p class="s-account__card-eyebrow">Latest Recommendation</p>
          <div id="am-account-recommendation" class="s-account__recommendation">
            Your first styling recommendation will be summarized here after the AI
            Stylist runs.
          </div>
        </article>
      </div>
    </div>
  </div>
</section>


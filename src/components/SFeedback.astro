<div id="am-fb-root" class="am-fb-overlay" hidden aria-hidden="true">
  <div class="am-fb-overlay__backdrop" data-am-fb-close></div>

  <div
    class="am-fb-overlay__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="am-fb-title"
  >
    <header class="am-fb-overlay__header">
      <div>
        <p class="am-fb-overlay__eyebrow">Feedback</p>
        <h3 id="am-fb-title" class="am-fb-overlay__title">Share Feedback</h3>
      </div>

      <button
        id="am-fb-close"
        class="am-styling-close"
        type="button"
        data-am-fb-close
        aria-label="Close feedback"
      >
        Close
      </button>
    </header>

    <div class="am-fb-overlay__body">
      <p id="am-fb-target" class="am-fb-target"></p>

      <div class="am-fb-field">
        <span class="am-fb-label">Rating</span>
        <div id="am-fb-rating" class="am-fb-stars" role="radiogroup" aria-label="Rating from 1 to 5">
          <button class="am-fb-star" type="button" data-value="1" role="radio" aria-checked="false" aria-label="1 star">★</button>
          <button class="am-fb-star" type="button" data-value="2" role="radio" aria-checked="false" aria-label="2 stars">★</button>
          <button class="am-fb-star" type="button" data-value="3" role="radio" aria-checked="false" aria-label="3 stars">★</button>
          <button class="am-fb-star" type="button" data-value="4" role="radio" aria-checked="false" aria-label="4 stars">★</button>
          <button class="am-fb-star" type="button" data-value="5" role="radio" aria-checked="false" aria-label="5 stars">★</button>
        </div>
      </div>

      <label class="am-fb-field" for="am-fb-comment">
        <span class="am-fb-label">Comment <span class="am-fb-optional">(optional)</span></span>
        <textarea
          id="am-fb-comment"
          class="am-fb-textarea"
          rows="4"
          maxlength="500"
          placeholder="Tell us what worked, or what to improve…"
        ></textarea>
      </label>

      <p id="am-fb-status" class="am-fb-status" role="status" aria-live="polite"></p>

      <button id="am-fb-submit" class="am-button am-fb-submit" type="button">
        Submit Feedback
      </button>
    </div>
  </div>
</div>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import { API_BASE_URL } from '../auramirror/config.js'
  import { getApiToken, authHeaders, apiFetch } from '../auramirror/shared/api.js'

  // --- Configurable routing (the doc marks the feedback API as inferred) ---
  const FEEDBACK_MODE = 'history' // 'history' (Plan 1) keeps history feedback nested; others use the standalone route
  const HISTORY_FEEDBACK_PATH = (id) =>
    `${API_BASE_URL}/histories/${encodeURIComponent(id)}/feedback`
  const STANDALONE_FEEDBACK_PATH = `${API_BASE_URL}/feedback`

  const OVERLAY_TRANSITION_MS = 280
  const MAX_RATING = 5

  class FeedbackWidget {
    constructor() {
      this.root = document.getElementById('am-fb-root')
      if (!this.root) return

      this.dialog = this.root.querySelector('.am-fb-overlay__dialog')
      this.titleEl = this.root.querySelector('#am-fb-title')
      this.targetEl = this.root.querySelector('#am-fb-target')
      this.ratingEl = this.root.querySelector('#am-fb-rating')
      this.starEls = Array.from(this.root.querySelectorAll('.am-fb-star'))
      this.commentEl = this.root.querySelector('#am-fb-comment')
      this.statusEl = this.root.querySelector('#am-fb-status')
      this.submitBtn = this.root.querySelector('#am-fb-submit')

      this.targetType = 'history'
      this.targetId = ''
      this.context = {}
      this.rating = 0
      this.submitting = false
      this.lastFocused = null
      this.hideTimer = 0

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      // Move to <body> so the modal escapes the .site-wrapper clip-path.
      if (this.root.parentElement !== document.body) {
        document.body.appendChild(this.root)
      }

      this.bindEvents()
    }

    bindEvents() {
      document.addEventListener('am:open-feedback', (event) => {
        this.open(event.detail || {})
      })

      this.root.addEventListener('click', (event) => {
        if (event.target.closest('[data-am-fb-close]')) this.close()
      })

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.root.dataset.open === 'true') this.close()
      })

      this.ratingEl?.addEventListener('click', (event) => {
        const star = event.target.closest('.am-fb-star')
        if (star) this.setRating(Number(star.getAttribute('data-value')) || 0)
      })
      this.ratingEl?.addEventListener('mouseover', (event) => {
        const star = event.target.closest('.am-fb-star')
        if (star) this.paintStars(Number(star.getAttribute('data-value')) || 0)
      })
      this.ratingEl?.addEventListener('mouseleave', () => this.paintStars(this.rating))
      this.ratingEl?.addEventListener('keydown', this.onRatingKeydown.bind(this))

      this.submitBtn?.addEventListener('click', () => this.submit())
    }

    /* ---------- open / close ---------- */

    open({ targetType, targetId, context } = {}) {
      if (!targetId) return

      this.targetType = String(targetType || 'history')
      this.targetId = String(targetId)
      this.context = context && typeof context === 'object' ? context : {}
      this.rating = 0
      this.submitting = false

      if (this.commentEl) this.commentEl.value = ''
      this.paintStars(0)
      this.setSubmitting(false)
      this.titleEl.textContent = `Rate this ${this.targetType}`
      this.targetEl.textContent = `Target: ${this.targetType} · ${this.shorten(this.targetId)}`

      if (!getApiToken()) {
        this.showStatus('Sign in to submit feedback.', 'note')
        if (this.submitBtn) this.submitBtn.disabled = true
      } else {
        this.clearStatus()
        if (this.submitBtn) this.submitBtn.disabled = false
      }

      this.openOverlay()
    }

    openOverlay() {
      this.lastFocused = document.activeElement
      if (this.hideTimer) {
        window.clearTimeout(this.hideTimer)
        this.hideTimer = 0
      }

      this.root.hidden = false
      this.root.setAttribute('aria-hidden', 'false')
      window.requestAnimationFrame(() => {
        this.root.dataset.open = 'true'
      })

      document.documentElement.classList.add('am-overlay-open')
      window.lenis?.stop?.()

      this.starEls[0]?.focus()
    }

    close() {
      if (this.submitting) return

      this.root.dataset.open = 'false'
      this.root.setAttribute('aria-hidden', 'true')

      if (this.hideTimer) window.clearTimeout(this.hideTimer)
      this.hideTimer = window.setTimeout(() => {
        this.root.hidden = true
        this.hideTimer = 0
      }, OVERLAY_TRANSITION_MS)

      document.documentElement.classList.remove('am-overlay-open')
      window.lenis?.start?.()

      if (this.lastFocused instanceof HTMLElement) this.lastFocused.focus()
      this.lastFocused = null
    }

    /* ---------- rating control ---------- */

    setRating(value) {
      this.rating = Math.max(0, Math.min(MAX_RATING, value))
      this.paintStars(this.rating)
      this.ratingEl?.classList.remove('is-invalid')

      this.starEls.forEach((star) => {
        const starValue = Number(star.getAttribute('data-value')) || 0
        star.setAttribute('aria-checked', starValue === this.rating ? 'true' : 'false')
      })

      if (this.statusEl?.dataset.kind === 'error') this.clearStatus()
    }

    paintStars(activeCount) {
      this.starEls.forEach((star) => {
        const starValue = Number(star.getAttribute('data-value')) || 0
        star.classList.toggle('is-on', starValue <= activeCount)
      })
    }

    onRatingKeydown(event) {
      let next = this.rating

      if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
        next = Math.min(MAX_RATING, (this.rating || 0) + 1)
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
        next = Math.max(1, (this.rating || 1) - 1)
      } else if (event.key === 'Home') {
        next = 1
      } else if (event.key === 'End') {
        next = MAX_RATING
      } else {
        return
      }

      event.preventDefault()
      this.setRating(next)
      this.starEls[next - 1]?.focus()
    }

    /* ---------- submit ---------- */

    async submit() {
      if (this.submitting) return

      if (!getApiToken()) {
        this.showStatus('Please sign in before submitting feedback.', 'error')
        return
      }

      if (this.rating < 1) {
        this.showStatus('Please select a rating (1–5).', 'error')
        this.ratingEl?.classList.add('is-invalid')
        this.starEls[0]?.focus()
        return
      }

      this.setSubmitting(true)
      this.showStatus('Submitting…', 'note')

      const comment = (this.commentEl?.value || '').trim()
      const useHistoryRoute = FEEDBACK_MODE === 'history' && this.targetType === 'history'
      const url = useHistoryRoute
        ? HISTORY_FEEDBACK_PATH(this.targetId)
        : STANDALONE_FEEDBACK_PATH
      const body = useHistoryRoute
        ? { rating: this.rating, comment, context: this.context }
        : {
            target_type: this.targetType,
            target_id: this.targetId,
            rating: this.rating,
            comment,
          }

      try {
        await apiFetch(url, {
          method: 'POST',
          headers: authHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify(body),
        })

        this.submitting = false
        this.showStatus('Feedback submitted — thank you!', 'success')
        document.dispatchEvent(
          new CustomEvent('am:feedback-submitted', {
            detail: {
              targetType: this.targetType,
              targetId: this.targetId,
              rating: this.rating,
            },
          })
        )
        window.setTimeout(() => this.close(), 1200)
      } catch (error) {
        this.setSubmitting(false)
        this.showStatus(`Couldn’t submit: ${this.errorMessage(error)}`, 'error')
      }
    }

    setSubmitting(state) {
      this.submitting = state
      if (this.submitBtn) {
        this.submitBtn.disabled = state || !getApiToken()
        this.submitBtn.textContent = state ? 'Submitting…' : 'Submit Feedback'
      }
      if (this.commentEl) this.commentEl.readOnly = state
      this.starEls.forEach((star) => {
        star.disabled = state
      })
    }

    /* ---------- helpers ---------- */

    showStatus(message, kind = 'note') {
      if (!this.statusEl) return
      this.statusEl.textContent = message
      this.statusEl.dataset.kind = kind
      this.statusEl.hidden = false
    }

    clearStatus() {
      if (!this.statusEl) return
      this.statusEl.textContent = ''
      this.statusEl.removeAttribute('data-kind')
      this.statusEl.hidden = true
    }

    shorten(id) {
      return id.length > 18 ? `${id.slice(0, 8)}…${id.slice(-6)}` : id
    }

    errorMessage(error) {
      return error instanceof Error ? error.message : 'unknown error'
    }
  }

  new FeedbackWidget()
</script>

<style is:global lang="scss">
  /* Namespaced `am-fb-*` rules. `is:global` keeps the widget consistent with the
     other new pages and collision-free via the prefix. */
  .am-fb-overlay {
    position: fixed;
    inset: 0;
    z-index: 58;

    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.28s ease,
      visibility 0.28s ease;

    &[hidden] {
      display: none;
    }

    &[data-open='true'] {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  .am-fb-overlay__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(22, 0, 0, 0.72);
    backdrop-filter: blur(8px);
  }

  .am-fb-overlay__dialog {
    position: relative;
    z-index: 1;

    width: min(30rem, 100%);
    max-height: calc(100vh - 2rem);
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    scrollbar-width: none;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(244, 12, 63, 0.09), transparent 25%),
      color(primary);
    box-shadow: 0 2rem 4rem rgba(0, 0, 0, 0.32);

    opacity: 0;
    transform: translate3d(0, 1rem, 0) scale(0.985);
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
    will-change: opacity, transform;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .am-fb-overlay[data-open='true'] .am-fb-overlay__dialog {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .am-fb-overlay__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.25rem 0;
  }

  .am-fb-overlay__eyebrow {
    margin: 0 0 0.4rem;
    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-fb-overlay__title {
    margin: 0;
    font: 700 clamp(1.6rem, 3vw, 2.4rem) / 0.95 font-family(bigger);
    text-transform: uppercase;
  }

  .am-fb-overlay__body {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .am-fb-target {
    margin: 0;
    font: 400 0.92rem / 1.4 font-family(editorial);
    opacity: 0.72;
    word-break: break-all;
  }

  .am-fb-field {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .am-fb-label {
    font: 700 0.75rem / 1.2 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-fb-optional {
    opacity: 0.5;
  }

  .am-fb-stars {
    display: inline-flex;
    gap: 0.35rem;

    &.is-invalid .am-fb-star {
      color: rgba(244, 12, 63, 0.4);
    }
  }

  .am-fb-star {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;

    padding: 0.1rem;
    line-height: 1;
    font-size: 1.9rem;
    color: rgba(22, 0, 0, 0.22);

    transition:
      color 0.15s ease,
      transform 0.15s ease;

    &.is-on {
      color: var(--am-accent, #f40c3f);
    }

    &:hover {
      transform: translateY(-1px);
    }

    &:focus-visible {
      outline: 2px solid var(--am-accent, #f40c3f);
      outline-offset: 2px;
    }

    &:disabled {
      cursor: default;
    }
  }

  .am-fb-textarea {
    width: 100%;
    box-sizing: border-box;
    resize: vertical;

    border: 1px solid color(secondary);
    background: rgba(255, 255, 255, 0.68);
    color: color(secondary);
    padding: 0.85rem 1rem;

    font: 400 0.98rem / 1.4 font-family(editorial);

    &::placeholder {
      color: currentColor;
      opacity: 0.42;
    }
  }

  .am-fb-status {
    margin: 0;
    min-height: 1.2em;
    font: 400 0.9rem / 1.4 font-family(editorial);
    color: color(secondary);

    &[hidden] {
      display: none;
    }

    &[data-kind='error'] {
      color: var(--am-accent, #f40c3f);
    }

    &[data-kind='success'] {
      font-weight: 700;
    }
  }

  .am-fb-submit {
    width: 100%;
  }
</style>

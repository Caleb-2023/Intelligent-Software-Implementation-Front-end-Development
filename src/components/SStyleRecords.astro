<section id="am-styles-section" class="am-styles-section" data-intersect aria-label="Recommendation records">
  <div class="am-styles-grid" aria-hidden="true">
    <svg class="am-styles-grid__svg" aria-hidden="true" focusable="false">
      <path class="am-styles-grid__path" d=""></path>
    </svg>
  </div>

  <div class="am-styles-shell">
    <div class="am-styles-panel">
      <header class="am-styles-panel__header">
        <div>
          <p class="am-styles-eyebrow">Cloud Records</p>
          <h2 class="am-styles-title">Recommendation Records</h2>
        </div>

        <button
          id="am-styles-refresh"
          class="am-button am-button--ghost"
          type="button"
          aria-label="Refresh recommendation records"
        >
          Refresh
        </button>
      </header>

      <p id="am-styles-status" class="am-styles-status" role="status" aria-live="polite" hidden></p>

      <div class="am-styles-panel__body">
        <div id="am-styles-list" class="am-styles-list" aria-label="Saved recommendations">
          <div class="am-empty-state">Loading your recommendation records…</div>
        </div>

        <aside class="am-styles-focus" aria-live="polite" aria-label="Recommendation detail">
          <p class="am-styles-focus__eyebrow">Focus Detail</p>
          <div id="am-styles-focus-content" class="am-styles-focus__content">
            Select a record’s “View” to inspect its recommended items and preview.
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import { API_BASE_URL } from '../auramirror/config.js'
  import { escapeHtml } from '../auramirror/dom'
  import {
    getApiToken,
    authHeaders,
    apiFetch,
    resolveAssetUrl,
  } from '../auramirror/shared/api.js'
  import { createRippleGrid } from '../auramirror/shared/grid.js'

  const STYLES_URL = `${API_BASE_URL}/styles`

  class StyleRecords {
    constructor() {
      this.el = document.getElementById('am-styles-section')
      if (!this.el) return

      this.listEl = this.el.querySelector('#am-styles-list')
      this.focusEl = this.el.querySelector('#am-styles-focus-content')
      this.statusEl = this.el.querySelector('#am-styles-status')
      this.refreshBtn = this.el.querySelector('#am-styles-refresh')

      this.styles = []
      this.confirmingId = null
      this.detailId = null

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      this.initGrid()
      this.bindEvents()
      this.load()
    }

    initGrid() {
      const gridEl = this.el.querySelector('.am-styles-grid')
      const gridPath = this.el.querySelector('.am-styles-grid__path')
      if (gridEl && gridPath) this.grid = createRippleGrid(gridEl, gridPath)
    }

    bindEvents() {
      this.refreshBtn?.addEventListener('click', () => this.load())
      this.listEl?.addEventListener('click', this.onListClick.bind(this))
      this.focusEl?.addEventListener('click', this.onFocusClick.bind(this))
    }

    /* ---------- data ---------- */

    async load() {
      if (!this.listEl) return

      if (!getApiToken()) {
        this.renderAuthGate()
        return
      }

      this.clearStatus()
      this.detailId = null
      this.listEl.innerHTML =
        '<div class="am-empty-state">Loading your recommendation records…</div>'

      try {
        const data = await apiFetch(STYLES_URL, { headers: authHeaders() })
        const items = Array.isArray(data)
          ? data
          : data?.styles || data?.data?.styles || []
        this.styles = items
          .map((item) => this.normalizeStyle(item))
          .filter((item) => item.id)
        this.renderList()
        this.renderFocus(null)
      } catch (error) {
        this.renderError(error)
      }
    }

    normalizeStyle(raw) {
      return {
        id: String(raw?.style_id || raw?._id || raw?.id || ''),
        occasion: String(raw?.occasion || 'Look'),
        createdAt: raw?.created_at || raw?.createdAt || '',
        count: Array.isArray(raw?.recommendations) ? raw.recommendations.length : 0,
      }
    }

    formatDate(value) {
      if (!value) return 'Unknown date'
      const date = new Date(value)
      if (Number.isNaN(date.getTime())) return 'Unknown date'
      try {
        return new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        }).format(date)
      } catch {
        return 'Unknown date'
      }
    }

    scorePct(score) {
      const value = Number(score)
      return Number.isFinite(value) ? `${Math.round(value * 100)}%` : '—'
    }

    lookLabel(count) {
      return `${count} look${count === 1 ? '' : 's'}`
    }

    /* ---------- list rendering ---------- */

    renderList() {
      if (!this.listEl) return

      if (!this.styles.length) {
        this.listEl.innerHTML =
          '<div class="am-empty-state">No cloud recommendation records yet. Run the AI Stylist to create one.</div>'
        return
      }

      this.listEl.innerHTML = this.styles.map((style) => this.cardHtml(style)).join('')
    }

    cardHtml(style) {
      const safeId = escapeHtml(style.id)
      const confirming = style.id === this.confirmingId
      const active = style.id === this.detailId

      const actions = confirming
        ? `<button class="am-button am-styles-card__action" type="button" data-action="confirm-delete">Confirm</button>
           <button class="am-button am-button--ghost am-styles-card__action" type="button" data-action="cancel-delete">Cancel</button>`
        : `<button class="am-button am-styles-card__action" type="button" data-action="view"${active ? ' disabled' : ''}>${active ? 'Viewing' : 'View'}</button>
           <button class="am-button am-button--ghost am-styles-card__action" type="button" data-action="feedback">Feedback</button>
           <button class="am-button am-button--ghost am-styles-card__action" type="button" data-action="delete">Delete</button>`

      return `
        <article class="am-styles-card${active ? ' is-active' : ''}" data-style-id="${safeId}">
          <span class="am-styles-card__eyebrow">Recommendation</span>
          <strong class="am-styles-card__title">${escapeHtml(style.occasion)}</strong>
          <span class="am-styles-card__meta">${escapeHtml(this.formatDate(style.createdAt))}</span>
          <span class="am-styles-card__meta">${escapeHtml(this.lookLabel(style.count))}</span>
          <span class="am-styles-card__actions">${actions}</span>
        </article>`
    }

    renderAuthGate() {
      if (this.listEl) {
        this.listEl.innerHTML =
          '<div class="am-empty-state">Sign in to view your cloud recommendation records.</div>'
      }
      this.renderFocus(null)
    }

    renderError(error) {
      if (!this.listEl) return
      this.listEl.innerHTML = `
        <div class="am-empty-state am-styles-error">
          <p>Couldn’t load your recommendation records: ${escapeHtml(this.errorMessage(error))}</p>
          <button class="am-button am-button--ghost" type="button" data-action="retry">Retry</button>
        </div>`
      this.renderFocus(null)
    }

    /* ---------- focus / detail ---------- */

    renderFocus(entry) {
      if (!this.focusEl) return
      if (!entry) {
        this.focusEl.innerHTML =
          'Select a record’s “View” to inspect its recommended items and preview.'
      }
    }

    renderFocusLoading() {
      if (this.focusEl) this.focusEl.innerHTML = 'Loading recommendation detail…'
    }

    renderFocusDetail(id, detail) {
      if (!this.focusEl) return

      const record = this.styles.find((style) => style.id === id)
      const items = Array.isArray(detail?.recommended_items) ? detail.recommended_items : []
      const previewUrl = resolveAssetUrl(detail?.preview_image_url || '')

      const previewBlock = previewUrl
        ? `<figure class="am-styles-detail__media">
             <img src="${escapeHtml(previewUrl)}" alt="Recommendation preview" />
             <span class="am-styles-detail__media-fallback" hidden>Preview unavailable</span>
           </figure>`
        : ''

      const itemsBlock = items.length
        ? `<ul class="am-styles-detail__items">${items
            .map((item) => {
              const clothId = escapeHtml(
                String(item?.cloth_id || item?.clothId || item?.item_id || 'item')
              )
              const reason = item?.reason ? escapeHtml(String(item.reason)) : ''
              return `<li class="am-styles-detail__item">
                <div class="am-styles-detail__item-head">
                  <strong>${clothId}</strong>
                  <span>${escapeHtml(this.scorePct(item?.score))}</span>
                </div>
                ${reason ? `<p class="am-styles-detail__reason">${reason}</p>` : ''}
              </li>`
            })
            .join('')}</ul>`
        : '<p class="am-styles-detail__row">No recommended items recorded for this look.</p>'

      this.focusEl.innerHTML = `
        <div class="am-styles-detail">
          ${previewBlock}
          <p class="am-styles-detail__row"><strong>Occasion:</strong> ${escapeHtml(record?.occasion || 'Look')}</p>
          <p class="am-styles-detail__row"><strong>Saved:</strong> ${escapeHtml(this.formatDate(record?.createdAt))}</p>
          ${itemsBlock}
          <button class="am-button am-styles-detail__feedback" type="button" data-action="feedback">Leave Feedback</button>
        </div>`

      this.attachFocusImageFallback()
    }

    renderFocusError(error) {
      if (this.focusEl) {
        this.focusEl.innerHTML = `Couldn’t load detail: ${escapeHtml(this.errorMessage(error))}`
      }
    }

    attachFocusImageFallback() {
      const img = this.focusEl?.querySelector('.am-styles-detail__media img')
      if (!img) return
      img.addEventListener(
        'error',
        () => {
          img.style.display = 'none'
          const fallback = img.parentElement?.querySelector('.am-styles-detail__media-fallback')
          if (fallback) fallback.hidden = false
        },
        { once: true }
      )
    }

    /* ---------- interaction ---------- */

    onListClick(event) {
      const trigger = event.target.closest('[data-action]')
      if (!trigger) return

      const action = trigger.getAttribute('data-action')
      if (action === 'retry') {
        this.load()
        return
      }

      const card = event.target.closest('[data-style-id]')
      const id = card?.getAttribute('data-style-id')
      if (!id) return

      if (action === 'view') this.showDetail(id)
      else if (action === 'feedback') this.requestFeedback(id)
      else if (action === 'delete') this.setConfirming(id)
      else if (action === 'confirm-delete') this.deleteStyle(id)
      else if (action === 'cancel-delete') this.setConfirming(null)
    }

    onFocusClick(event) {
      const trigger = event.target.closest('[data-action="feedback"]')
      if (!trigger || !this.detailId) return
      this.requestFeedback(this.detailId)
    }

    setConfirming(id) {
      this.confirmingId = id
      this.renderList()
    }

    requestFeedback(id) {
      document.dispatchEvent(
        new CustomEvent('am:open-feedback', {
          detail: { targetType: 'style', targetId: id, context: {} },
        })
      )
    }

    async showDetail(id) {
      this.detailId = id
      this.renderList()
      this.renderFocusLoading()
      try {
        const data = await apiFetch(`${STYLES_URL}/${encodeURIComponent(id)}`, {
          headers: authHeaders(),
        })
        if (this.detailId !== id) return
        this.renderFocusDetail(id, data?.style || data || {})
      } catch (error) {
        if (this.detailId !== id) return
        this.renderFocusError(error)
      }
    }

    async deleteStyle(id) {
      try {
        await apiFetch(`${STYLES_URL}/${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: authHeaders(),
        })
        this.styles = this.styles.filter((style) => style.id !== id)
        this.confirmingId = null
        if (this.detailId === id) {
          this.detailId = null
          this.renderFocus(null)
        }
        this.clearStatus()
        this.renderList()
      } catch (error) {
        this.confirmingId = null
        this.showStatus(`Delete failed: ${this.errorMessage(error)}`)
        this.renderList()
      }
    }

    /* ---------- status helpers ---------- */

    showStatus(message) {
      if (!this.statusEl) return
      this.statusEl.textContent = message
      this.statusEl.hidden = false
    }

    clearStatus() {
      if (!this.statusEl) return
      this.statusEl.textContent = ''
      this.statusEl.hidden = true
    }

    errorMessage(error) {
      return error instanceof Error ? error.message : 'unknown error'
    }
  }

  new StyleRecords()
</script>

<style is:global lang="scss">
  /* Namespaced `am-styles-*` rules. `is:global` is intentional: cards/detail are
     rendered via innerHTML and would not match Astro-scoped selectors. */
  .am-styles-section {
    position: relative;
    z-index: 2;

    padding: 8rem 0 10rem;

    overflow: hidden;
    isolation: isolate;

    background:
      radial-gradient(circle at top left, rgba(244, 12, 63, 0.08), transparent 32%),
      linear-gradient(180deg, rgba(22, 0, 0, 0.04), transparent 22%);

    @include mq(tablet-sm) {
      padding: 6.5rem 0 8rem;
    }

    @include mq(phone) {
      padding: 5.5rem 0 6.5rem;
    }

    &:before {
      position: absolute;
      inset: 0;
      z-index: 0;

      background: radial-gradient(
        circle at 50% 44%,
        rgba(255, 255, 255, 0.24),
        transparent 54%
      );

      content: '';
      pointer-events: none;
    }
  }

  .am-styles-shell {
    position: relative;
    z-index: 1;

    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;

    @include mq(phone) {
      padding: 0 0.9rem;
    }
  }

  .am-styles-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .am-styles-grid__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .am-styles-grid__path {
    fill: none;
    stroke: color(secondary);
    stroke-width: 1px;
    opacity: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    shape-rendering: geometricPrecision;
    vector-effect: non-scaling-stroke;
  }

  .am-styles-panel {
    position: relative;
    z-index: 1;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(244, 12, 63, 0.06), transparent 24%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08)),
      rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
    box-shadow: 0 1.5rem 3rem rgba(22, 0, 0, 0.08);
  }

  .am-styles-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;

    padding: 1.25rem;
    border-bottom: 1px solid color(secondary);

    @include mq(phone) {
      flex-direction: column;
      align-items: stretch;
      padding: 0.9rem;
    }
  }

  .am-styles-eyebrow {
    margin: 0 0 0.5rem;
    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-styles-title {
    margin: 0;
    font: 700 clamp(2rem, 4vw, 4.2rem) / 0.92 font-family(bigger);
    text-transform: uppercase;
  }

  .am-styles-status {
    margin: 0;
    padding: 1rem 1.25rem 0;

    color: var(--am-accent, #f40c3f);
    font: 400 0.95rem / 1.45 font-family(editorial);

    &[hidden] {
      display: none;
    }
  }

  .am-styles-panel__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 1rem;
    align-items: start;

    padding: 1.25rem;

    @include mq(tablet) {
      grid-template-columns: 1fr;
    }

    @include mq(phone) {
      padding: 0.9rem;
    }
  }

  .am-styles-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem;
    align-content: start;
  }

  .am-styles-focus {
    min-height: 20rem;
    padding: 1rem;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(244, 12, 63, 0.08), transparent 42%),
      rgba(255, 255, 255, 0.42);
  }

  .am-styles-focus__eyebrow {
    margin: 0 0 0.5rem;
    font: 700 0.75rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-styles-focus__content {
    font: 400 1rem / 1.5 font-family(editorial);
  }

  /* ---- card ---- */
  .am-styles-card {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;

    padding: 1rem;

    border: 1px solid color(secondary);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.54)),
      rgba(244, 12, 63, 0.04);
    color: color(secondary);

    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      border-color: var(--am-accent, #f40c3f);
    }

    &.is-active {
      border-color: var(--am-accent, #f40c3f);
      background:
        linear-gradient(180deg, rgba(244, 12, 63, 0.16), rgba(244, 12, 63, 0.06)),
        rgba(22, 0, 0, 0.03);
    }
  }

  .am-styles-card__eyebrow {
    font: 700 0.72rem / 1 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .am-styles-card__title {
    margin: 0.1rem 0 0.15rem;
    font: 700 1.35rem / 0.95 font-family(bigger);
    text-transform: uppercase;
    word-break: break-word;
  }

  .am-styles-card__meta {
    font: 400 0.92rem / 1.3 font-family(editorial);
  }

  .am-styles-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    width: 100%;
    margin-top: 0.6rem;
  }

  .am-styles-card__action {
    padding: 0.5rem 0.7rem;
    font-size: 0.66rem;
  }

  /* ---- error ---- */
  .am-styles-error {
    flex-direction: column;
    gap: 1rem;
  }

  /* ---- detail ---- */
  .am-styles-detail__media {
    position: relative;
    margin: 0 0 1rem;
    border: 1px solid rgba(22, 0, 0, 0.16);
    overflow: hidden;

    img {
      display: block;
      width: 100%;
      height: auto;
    }
  }

  .am-styles-detail__media-fallback {
    display: block;
    padding: 1rem;
    text-align: center;
    background: rgba(22, 0, 0, 0.06);
    font: 400 0.9rem / 1.3 font-family(editorial);
  }

  .am-styles-detail__row {
    margin: 0 0 0.5rem;
  }

  .am-styles-detail__items {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .am-styles-detail__item {
    padding: 0.6rem 0.75rem;
    border: 1px solid rgba(22, 0, 0, 0.16);
    background: rgba(255, 255, 255, 0.45);
  }

  .am-styles-detail__item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;

    font: 700 0.95rem / 1.2 font-family(fraktion);
    letter-spacing: 0.04em;
    word-break: break-all;
  }

  .am-styles-detail__reason {
    margin: 0.35rem 0 0;
    font: 400 0.92rem / 1.4 font-family(editorial);
  }

  .am-styles-detail__feedback {
    margin-top: 1rem;
  }
</style>

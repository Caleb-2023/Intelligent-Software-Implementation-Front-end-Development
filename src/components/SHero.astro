---
import ASeparator from './ASeparator.astro'

const authPreviewLines = [
  {
    mode: 'login',
    label: 'Sign In',
    chars: ['S', 'I', 'G', 'N', '&nbsp;', 'I', 'N'],
  },
  {
    mode: 'register',
    label: 'Sign Up',
    chars: ['S', 'I', 'G', 'N', '&nbsp;', 'U', 'P'],
  },
]
---

<div class="s-hero" data-intersect>
  <div class="s__auth-slot">
    <div class="s__auth-action" data-auth-action="auth">
      <div class="s__auth-hover js-auth-hover">
        <button
          class="s__auth-btn js-auth-btn"
          type="button"
          aria-haspopup="dialog"
          aria-controls="am-auth-overlay"
          aria-expanded="false"
        >
          <div class="s__auth-btn__inner">
            <div class="s__auth-btn__text js-auth-btn-text am-auth-nav-button">
              Let's Go
            </div>
          </div>
        </button>
      </div>
    </div>

    <div class="s__auth-greeting" data-auth-greeting hidden aria-hidden="true">
      <p id="am-auth-greeting-line-1" class="s__auth-greeting-line s__auth-greeting-line--lead">
        Aura Member, good evening.
      </p>
      <p id="am-auth-greeting-line-2" class="s__auth-greeting-line">
        Ready to style your outfit for today?
      </p>
      <button
        id="am-open-dashboard"
        class="s__auth-dashboard-button"
        type="button"
        hidden
        data-dashboard-trigger
      >
        Dashboard
      </button>
    </div>
  </div>

  <div id="am-auth-overlay" class="s__auth-cta js-auth-cta" aria-hidden="true">
    <div class="s__auth-cta__backdrop" data-auth-close></div>
    <div class="s__auth-cta__scroll" data-lenis-prevent>
      <div
        class="am-auth-overlay__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="am-auth-title"
      >
        <header class="am-auth-overlay__header">
          <div>
            <p class="am-auth-overlay__eyebrow">Module 00</p>
            <h2 id="am-auth-title" class="am-auth-overlay__title">Aura<br />Mirror</h2>
            <p class="am-auth-overlay__sub">AI Smart Wardrobe</p>
          </div>

          <button
            id="am-auth-close"
            class="am-styling-close js-auth-close"
            type="button"
            aria-label="Close authentication dialog"
          >
            Close
          </button>
        </header>

        <div class="am-auth-overlay__tabs" role="tablist" aria-label="Authentication tabs">
          <button
            id="am-auth-tab-login"
            class="am-auth-tab is-active"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="am-auth-panel-login"
            data-auth-tab="login"
          >
            Sign In
          </button>
          <button
            id="am-auth-tab-register"
            class="am-auth-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="am-auth-panel-register"
            data-auth-tab="register"
          >
            Register
          </button>
        </div>

        <div class="am-auth-overlay__body">
          <p id="am-auth-status" class="am-status am-auth-status">
            Sign in to connect the live wardrobe, remote try-on, and recommendation APIs.
          </p>

          <section
            id="am-auth-panel-login"
            class="am-auth-panel"
            role="tabpanel"
            aria-labelledby="am-auth-tab-login"
          >
            <form id="am-login-form" class="am-auth-form">
              <label class="am-label">
                Email
                <input
                  id="am-login-email"
                  class="am-input"
                  type="email"
                  name="email"
                  autocomplete="email"
                  placeholder="you@example.com"
                  required
                />
              </label>

              <label class="am-label">
                Password
                <input
                  id="am-login-password"
                  class="am-input"
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  placeholder="Enter your password"
                  required
                />
              </label>

              <button class="am-button am-auth-overlay__submit" type="submit">Sign In</button>
            </form>
          </section>

          <section
            id="am-auth-panel-register"
            class="am-auth-panel"
            role="tabpanel"
            aria-labelledby="am-auth-tab-register"
            hidden
          >
            <form id="am-register-form" class="am-auth-form">
              <label class="am-label">
                Name
                <input
                  id="am-register-name"
                  class="am-input"
                  type="text"
                  name="name"
                  autocomplete="name"
                  placeholder="Your name"
                  required
                />
              </label>

              <label class="am-label">
                Email
                <input
                  id="am-register-email"
                  class="am-input"
                  type="email"
                  name="email"
                  autocomplete="email"
                  placeholder="you@example.com"
                  required
                />
              </label>

              <label class="am-label">
                Password
                <input
                  id="am-register-password"
                  class="am-input"
                  type="password"
                  name="password"
                  autocomplete="new-password"
                  placeholder="Minimum 6 characters"
                  required
                />
              </label>

              <button class="am-button am-auth-overlay__submit" type="submit">Create Account</button>
            </form>
          </section>
        </div>

        <footer class="am-auth-overlay__footer">
          <span class="am-auth-overlay__footer-text">Your wardrobe / your data / your style.</span>
        </footer>
      </div>
    </div>
  </div>

  <div class="s__content js-content">
    <h1 class="s__title">
      <span class="s__title__word js-word">Aura</span>
      <img
        class="s__title__asset js-star"
        src="/images/asset-star.svg"
        alt=""
        width="48"
        height="48"
      />
      <span class="s__title__word js-word">Mirror</span>
    </h1>

    <ASeparator
      class="s__separator js-separator"
      strings={['Do', 'Things', 'Your', 'Way']}
    />
  </div>

  <div class="s__border js-border"></div>
</div>

<div class="s__auth-preview js-auth-preview" aria-hidden="true">
  {
    authPreviewLines.map((line, index) => (
      <div
        class:list={[
          's__auth-preview__line',
          `s__auth-preview__line--${index === 0 ? 'top' : 'bottom'}`,
        ]}
      >
        <button
          class="s__auth-preview__option js-auth-preview-option"
          type="button"
          data-auth-mode={line.mode}
          aria-label={line.label}
        >
          <span class="s__auth-preview__word">
            {line.chars.map((char) => (
              <span class="s__auth-preview__char">
                {['', '', '', ''].map((_, sliceIndex) => (
                  <span
                    class="s__auth-preview__char__slice"
                    data-slice={sliceIndex + 1}
                    set:html={char}
                  />
                ))}
              </span>
            ))}
          </span>
        </button>
      </div>
    ))
  }

  <div class="s__auth-preview__dots"></div>
</div>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'

  import { gsap } from 'gsap/dist/gsap'
  import { SplitText } from 'gsap/dist/SplitText'
  gsap.registerPlugin(SplitText)

  class Section {
    el: HTMLElement
    words: NodeListOf<HTMLElement>

    isPaused: boolean
    isWaiting: boolean
    st: SplitText

    authHover: HTMLElement
    authBtn: HTMLElement
    authBtnText: HTMLElement
    authPreview: HTMLElement
    authCta: HTMLElement
    authPulseTl: gsap.core.Timeline
    authIsOpen: boolean
    authPreviewIsOpen: boolean
    authGreeting: HTMLElement
    authGreetingLine1: HTMLElement
    authGreetingLine2: HTMLElement
    authDashboardButton: HTMLElement
    greetingReady: boolean
    greetingPayload: {
      active: boolean
      line1: string
      line2: string
    }
    greetingSignature: string
    greetingTimers: number[]
    greetingRunId: number
    dashboardRevealFrame: number

    constructor() {
      this.el = document.querySelector('.s-hero')
      this.words = this.el.querySelectorAll('.js-word')

      this.isPaused = true
      this.isWaiting = true
      this.greetingReady = false
      this.greetingPayload = {
        active: false,
        line1: '',
        line2: '',
      }
      this.greetingSignature = ''
      this.greetingTimers = []
      this.greetingRunId = 0
      this.dashboardRevealFrame = 0

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      this.splitWords()
      this.initAuthButton()
      this.initGreeting()
      this.bindEvents()
    }

    bindEvents() {
      Emitter.on('resize', this.onResize, this)

      document.addEventListener('intro', this.intro.bind(this), { once: true })

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })

      document.addEventListener(
        'am:greeting-update',
        this.onGreetingUpdate.bind(this)
      )

      Emitter.on('tick', this.tick, this)
    }

    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }
    }

    onResize() {
      this.splitWords()
    }

    intro() {
      const authSlot = this.el.querySelector('.s__auth-slot')
      const content = this.el.querySelector('.js-content')
      const border = this.el.querySelector('.js-border')
      const chars = content.querySelectorAll('.char__inner')
      const separators = content.querySelectorAll('.js-separator')
      const star = content.querySelector('.js-star')

      const tl = gsap.timeline()

      tl.set(
        this.el,
        {
          opacity: 1,
        },
        0
      )

      tl.to(
        border,
        {
          scaleY: 0.025,
          y: -content.clientHeight,
          duration: 1,
          ease: 'expo.inOut',
        },
        0
      )

      tl.from(
        authSlot,
        {
          y: '-100%',
          duration: 1.5,
          ease: 'expo.out',
        },
        1.5
      )

      tl.fromTo(
        content,
        {
          clipPath: 'polygon(0 0, 100% 0, 100% 0, 0 0)',
        },
        {
          clipPath: 'polygon(0 0, 100% 0, 100% 100%, 0 100%)',
          duration: 1,
          ease: 'expo.inOut',
        },
        1
      )

      tl.to(
        border,
        {
          scaleY: 1,
          y: 0,
          duration: 1,
          ease: 'expo.inOut',
        },
        1
      )

      tl.from(
        star,
        {
          rotate: 90,
          duration: 2,
          ease: 'expo.out',
        },
        1.5
      )

      tl.fromTo(
        chars,
        {
          y: '-200%',
        },
        {
          y: '-100%',
          duration: 2,
          ease: 'expo.inOut',
          stagger: 0.02,
        },
        0.45
      )

      tl.from(
        separators,
        {
          y: (index) => (index % 2 === 0 ? '-100%' : '100%'),
          duration: 1.5,
          ease: 'expo.inOut',
        },
        0.75
      )

      tl.call(() => {
        this.isWaiting = false
        this.greetingReady = true
        this.syncGreetingFromDom()
        this.playGreetingIfReady()
      })
    }

    initGreeting() {
      this.authGreeting = this.el.querySelector('[data-auth-greeting]')
      this.authGreetingLine1 = document.getElementById('am-auth-greeting-line-1')
      this.authGreetingLine2 = document.getElementById('am-auth-greeting-line-2')
      this.authDashboardButton = document.querySelector('[data-dashboard-trigger]')

      this.syncGreetingFromDom()
    }

    syncGreetingFromDom() {
      if (!this.authGreeting || !this.authGreetingLine1 || !this.authGreetingLine2) {
        return
      }

      this.greetingPayload = {
        active: document.documentElement.classList.contains('am-authenticated'),
        line1:
          this.authGreeting.dataset.line1 ||
          this.authGreetingLine1.textContent ||
          '',
        line2:
          this.authGreeting.dataset.line2 ||
          this.authGreetingLine2.textContent ||
          '',
      }

      if (this.greetingPayload.active) {
        this.hideDashboardButton()
        this.clearGreetingLines()
      } else {
        this.hideDashboardButton()
      }
    }

    onGreetingUpdate(event: Event) {
      const detail = (event as CustomEvent)?.detail || {}

      const nextPayload = {
        active: Boolean(detail.active),
        line1: String(detail.line1 || ''),
        line2: String(detail.line2 || ''),
      }
      const nextSignature = JSON.stringify(nextPayload)

      this.greetingPayload = nextPayload

      if (!this.greetingPayload.active) {
        this.stopGreetingStream()
        this.greetingSignature = ''
        this.hideDashboardButton()
        this.clearGreetingLines()
        return
      }

      if (nextSignature === this.greetingSignature) {
        if (!this.hasGreetingContent()) {
          this.renderGreetingSnapshot()
        }
        this.showDashboardButton()
        return
      }

      this.hideDashboardButton()
      this.clearGreetingLines()
      this.playGreetingIfReady()
    }

    clearGreetingLines() {
      this.authGreetingLine1 && (this.authGreetingLine1.textContent = '')
      this.authGreetingLine2 && (this.authGreetingLine2.textContent = '')
    }

    hasGreetingContent() {
      const line1 = this.authGreetingLine1?.textContent?.trim() || ''
      const line2 = this.authGreetingLine2?.textContent?.trim() || ''

      return Boolean(line1 || line2)
    }

    renderGreetingSnapshot() {
      if (!this.authGreetingLine1 || !this.authGreetingLine2) {
        return
      }

      this.authGreetingLine1.textContent = this.greetingPayload.line1
      this.authGreetingLine2.textContent = this.greetingPayload.line2
    }

    hideDashboardButton() {
      if (!this.authDashboardButton) {
        return
      }

      if (this.dashboardRevealFrame) {
        window.cancelAnimationFrame(this.dashboardRevealFrame)
        this.dashboardRevealFrame = 0
      }

      this.authDashboardButton.classList.remove('is-visible')
      this.authDashboardButton.hidden = true
      this.authDashboardButton.setAttribute('aria-hidden', 'true')
    }

    showDashboardButton() {
      if (!this.authDashboardButton || !this.greetingPayload.active) {
        return
      }

      if (this.dashboardRevealFrame) {
        window.cancelAnimationFrame(this.dashboardRevealFrame)
        this.dashboardRevealFrame = 0
      }

      this.authDashboardButton.hidden = false
      this.authDashboardButton.setAttribute('aria-hidden', 'false')

      this.dashboardRevealFrame = window.requestAnimationFrame(() => {
        this.dashboardRevealFrame = window.requestAnimationFrame(() => {
          this.authDashboardButton?.classList.add('is-visible')
          this.dashboardRevealFrame = 0
        })
      })
    }

    stopGreetingStream() {
      this.greetingRunId += 1
      this.greetingTimers.forEach((timerId) => {
        window.clearTimeout(timerId)
      })
      this.greetingTimers = []
    }

    scheduleGreetingStep(callback, delay) {
      const timerId = window.setTimeout(() => {
        this.greetingTimers = this.greetingTimers.filter((id) => id !== timerId)
        callback()
      }, delay)

      this.greetingTimers.push(timerId)
    }

    typeGreetingLine(node: HTMLElement, text: string, runId: number, delay: number, onDone?) {
      if (!node) {
        onDone?.()
        return
      }

      node.textContent = ''

      if (!text) {
        onDone?.()
        return
      }

      let index = 0

      const step = () => {
        if (this.greetingRunId !== runId) return

        node.textContent += text.charAt(index)
        index += 1

        if (index < text.length) {
          this.scheduleGreetingStep(step, delay)
          return
        }

        onDone?.()
      }

      this.scheduleGreetingStep(step, delay)
    }

    playGreetingIfReady() {
      if (
        !this.greetingReady ||
        !this.greetingPayload.active ||
        !this.authGreetingLine1 ||
        !this.authGreetingLine2
      ) {
        return
      }

      const signature = JSON.stringify(this.greetingPayload)

      if (signature === this.greetingSignature) {
        if (!this.hasGreetingContent()) {
          this.renderGreetingSnapshot()
        }
        this.showDashboardButton()
        return
      }

      this.stopGreetingStream()
      this.clearGreetingLines()

      const runId = this.greetingRunId

      this.scheduleGreetingStep(() => {
        this.typeGreetingLine(
          this.authGreetingLine1,
          this.greetingPayload.line1,
          runId,
          42,
          () => {
            this.scheduleGreetingStep(() => {
              this.typeGreetingLine(
                this.authGreetingLine2,
                this.greetingPayload.line2,
                runId,
                24,
                () => {
                  this.greetingSignature = signature
                  this.showDashboardButton()
                }
              )
            }, 220)
          }
        )
      }, 240)
    }

    initAuthButton() {
      this.authHover = this.el.querySelector('.js-auth-hover')
      this.authBtn = this.el.querySelector('.js-auth-btn')
      this.authBtnText = this.el.querySelector('.js-auth-btn-text')
      this.authPreview = document.querySelector('.js-auth-preview')
      this.authCta = document.querySelector('.js-auth-cta')
      this.authIsOpen = false
      this.authPreviewIsOpen = false

      if (
        !this.authHover ||
        !this.authBtn ||
        !this.authBtnText ||
        !this.authPreview ||
        !this.authCta
      ) {
        return
      }

      // Move the hover preview to <body> so it is never clipped or layered
      // beneath other sections inside the page shell.
      if (this.authPreview.parentElement !== document.body) {
        document.body.appendChild(this.authPreview)
      }

      this.authPulseTl = gsap.timeline({
        repeat: -1,
        repeatDelay: 0.5,
      })

      this.authPulseTl.fromTo(
        this.authBtnText,
        { scale: 0.85 },
        { scale: 1.05, duration: 2.7, ease: 'power2.in' }
      )

      this.authPulseTl.to(this.authBtnText, {
        scale: 0.85,
        duration: 0.15,
        ease: 'power4.out',
      })

      this.authHover.addEventListener('mouseenter', () => {
        this.openAuthPreview()
      })

      this.authHover.addEventListener('mouseleave', (event: MouseEvent) => {
        if (
          event.relatedTarget instanceof Node &&
          this.authPreview.contains(event.relatedTarget)
        ) {
          return
        }

        this.closeAuthPreview()
      })

      this.authPreview.addEventListener('mouseenter', () => {
        if (!this.authPreviewIsOpen) return

        this.authPreview.setAttribute('data-open', 'true')
      })

      this.authPreview.addEventListener('mouseleave', (event: MouseEvent) => {
        if (
          event.relatedTarget instanceof Node &&
          this.authHover.contains(event.relatedTarget)
        ) {
          return
        }

        this.closeAuthPreview()
      })

      this.authBtn.addEventListener('click', (e) => {
        e.stopPropagation()

        if (this.authIsOpen) return

        if (window.safeWidth > 767) {
          this.openAuthPreview()
          return
        }

        if (this.authPreviewIsOpen) {
          this.openAuthPanel('login')
        } else {
          this.openAuthPreview()
        }
      })

      this.authPreview
        .querySelectorAll('.js-auth-preview-option')
        .forEach((option: HTMLElement) => {
          option.addEventListener('click', (event) => {
            event.stopPropagation()
            const mode = option.dataset.authMode === 'register' ? 'register' : 'login'
            this.openAuthPanel(mode)
          })
        })

      const closeBtn = this.authCta.querySelector('.js-auth-close')
      closeBtn?.addEventListener('click', () => {
        this.closeAuthPanel()
      })

      this.authCta.addEventListener('click', (e) => {
        if (
          e.target === this.authCta ||
          (e.target as Element)?.hasAttribute?.('data-auth-close')
        ) {
          this.closeAuthPanel()
        }
      })

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.authIsOpen) {
          this.closeAuthPanel()
        } else if (e.key === 'Escape' && this.authPreviewIsOpen) {
          this.closeAuthPreview()
        }
      })

      document.addEventListener('auth-panel-open', (event: Event) => {
        const detail = (event as CustomEvent)?.detail || {}
        const mode = detail.mode === 'register' ? 'register' : 'login'

        if (!this.authIsOpen) {
          this.openAuthPanel(mode)
        }
      })

      document.addEventListener('auth-panel-close', () => {
        if (this.authIsOpen) {
          this.closeAuthPanel()
        }
      })
    }

    openAuthPreview() {
      if (this.authIsOpen || this.authPreviewIsOpen) return

      this.authPreviewIsOpen = true
      document.documentElement.classList.add('am-auth-preview-open')
      this.authHover.classList.add('is-preview-active')
      this.authPreview.dataset.open = 'true'
      this.authPreview.setAttribute('aria-hidden', 'false')
      this.authBtn.setAttribute('aria-expanded', 'true')
      this.authPulseTl.pause()
    }

    closeAuthPreview() {
      if (!this.authPreviewIsOpen || this.authIsOpen) return

      this.authPreviewIsOpen = false
      document.documentElement.classList.remove('am-auth-preview-open')
      this.authHover.classList.remove('is-preview-active')
      delete this.authPreview.dataset.open
      this.authPreview.setAttribute('aria-hidden', 'true')
      this.authBtn.setAttribute('aria-expanded', 'false')
      this.authPulseTl.play(0)
    }

    openAuthPanel(mode = 'login') {
      const targetMode = mode === 'register' ? 'register' : 'login'
      const targetTab = document.getElementById(
        targetMode === 'register' ? 'am-auth-tab-register' : 'am-auth-tab-login'
      ) as HTMLElement

      this.authPreviewIsOpen = false
      this.authIsOpen = true
      document.documentElement.classList.add('am-auth-preview-open')
      this.authHover.classList.remove('is-preview-active')
      this.authHover.classList.add('is-active')
      this.authBtn.setAttribute('aria-expanded', 'true')
      delete this.authPreview.dataset.open
      this.authPreview.setAttribute('aria-hidden', 'true')
      this.authPulseTl.pause()

      this.authCta.dataset.open = 'true'
      this.authCta.setAttribute('aria-hidden', 'false')
      targetTab?.click()

      document.documentElement.classList.add('am-overlay-open')
      const lenis = window.lenis
      if (lenis && typeof lenis.stop === 'function') {
        lenis.stop()
      }

      setTimeout(() => {
        const closeBtn: HTMLElement = this.authCta.querySelector('.js-auth-close')
        closeBtn?.focus()
      }, 240)
    }

    closeAuthPanel() {
      this.authIsOpen = false
      document.documentElement.classList.remove('am-auth-preview-open')
      this.authHover.classList.remove('is-active')

      delete this.authCta.dataset.open
      this.authCta.setAttribute('aria-hidden', 'true')
      this.authBtn.setAttribute('aria-expanded', 'false')

      document.documentElement.classList.remove('am-overlay-open')
      const lenis = window.lenis
      if (lenis && typeof lenis.start === 'function') {
        lenis.start()
      }

      this.closeAuthPreview()
    }

    splitWords() {
      if (this.st) {
        this.st.revert()
      }

      this.st = new SplitText(this.words, {
        type: 'words,chars',
        charsClass: 'char',
        wordsClass: 'word',
      })

      this.st.chars.forEach((char: HTMLElement) => {
        const letter = char.textContent

        char.classList.add('char--' + letter)

        const inner = document.createElement('span')
        inner.classList.add('char__inner')

        inner.dataset.letter = letter.toUpperCase()
        inner.innerHTML = letter

        char.innerHTML = inner.outerHTML
      })
    }

    animateChar() {
      if (this.isWaiting || Math.random() > 0.01) return

      const char =
        this.st.chars[Math.floor(Math.random() * this.st.chars.length)]

      if (
        char.classList.contains('to-top') ||
        char.classList.contains('to-right') ||
        char.classList.contains('to-bottom') ||
        char.classList.contains('to-left')
      ) {
        return
      }

      const direction = Math.floor(Math.random() * 4)
      const className = 'to-' + ['bottom', 'left', 'top', 'right'][direction]

      char.classList.add(className)

      setTimeout(() => {
        char.classList.remove(className)
      }, 2000)
    }

    tick() {
      this.animateChar()
    }
  }

